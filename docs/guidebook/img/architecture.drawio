<diagram id="ai-flow" name="1a · ai.stream (flowchart)"><mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="F_try" parent="1" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=#f8fafc;strokeColor=#475569;fontColor=#475569;fontSize=17;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;" value="inside the adapter · any exception goes to the error exit" vertex="1"><mxGeometry x="430" y="690" width="1000" height="800" as="geometry"/></mxCell><mxCell id="F_chunk" parent="1" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#2563eb;fontSize=17;fontStyle=1;verticalAlign=top;align=right;spacingLeft=12;spacingRight=12;spacingTop=4;" value="chunk loop · each chunk from the vendor" vertex="1"><mxGeometry x="450" y="1010" width="960" height="270" as="geometry"/></mxCell><mxCell id="f1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f1f5f9;strokeColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;start: ai.stream(model, context, api_key)&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the agent loop calls this once for each model call&lt;/div&gt;" vertex="1"><mxGeometry x="470" y="0" width="460" height="90" as="geometry"/></mxCell><mxCell id="f2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="an adapter for&lt;br&gt;model.api?" vertex="1"><mxGeometry x="520" y="140" width="360" height="150" as="geometry"/></mxCell><mxCell id="f3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fef2f2;strokeColor=#dc2626;" value="&lt;b style=&quot;font-size:20px&quot;&gt;error event · end&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;error: &quot;Unknown api: …&quot;&lt;br&gt;no vendor is called&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;events: error&lt;/span&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1000" y="170" width="380" height="110" as="geometry"/></mxCell><mxCell id="f4" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#1d4ed8;" value="&lt;b style=&quot;font-size:20px&quot;&gt;clean the history (transform_messages)&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;drop failed or stopped answers&lt;br&gt;a tool call with no result gets &quot;No result provided&quot;&lt;br&gt;skip compaction and custom entries&lt;br&gt;fix thinking blocks for this model&lt;/div&gt;" vertex="1"><mxGeometry x="470" y="340" width="460" height="160" as="geometry"/></mxCell><mxCell id="f5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="an API key&lt;br&gt;was given?" vertex="1"><mxGeometry x="520" y="530" width="360" height="140" as="geometry"/></mxCell><mxCell id="f6" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fef2f2;strokeColor=#dc2626;" value="&lt;b style=&quot;font-size:20px&quot;&gt;error event · end&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;error: &quot;no API key for provider …&quot;&lt;br&gt;error_kind = fatal, so it is never retried&lt;br&gt;(only the built-in adapters check this)&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;events: error&lt;/span&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1000" y="555" width="380" height="110" as="geometry"/></mxCell><mxCell id="f7" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#1d4ed8;" value="&lt;b style=&quot;font-size:20px&quot;&gt;adapter: start&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;an empty answer, filled in as chunks come&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;events: start&lt;/span&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="470" y="730" width="460" height="100" as="geometry"/></mxCell><mxCell id="f8" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#1d4ed8;" value="&lt;b style=&quot;font-size:20px&quot;&gt;translate and send&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;our context → the vendor&#x27;s request&lt;br&gt;open the HTTP stream&lt;/div&gt;" vertex="1"><mxGeometry x="470" y="870" width="460" height="100" as="geometry"/></mxCell><mxCell id="f9" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="another chunk&lt;br&gt;from the vendor?" vertex="1"><mxGeometry x="520" y="1060" width="360" height="150" as="geometry"/></mxCell><mxCell id="f10" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#1d4ed8;" value="&lt;b style=&quot;font-size:20px&quot;&gt;parse the chunk&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;add its text to the answer&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;events: text_delta, thinking_start / _delta / _end, toolcall_start / _delta / _end&lt;/span&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1000" y="1070" width="380" height="140" as="geometry"/></mxCell><mxCell id="f11" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#1d4ed8;" value="&lt;b style=&quot;font-size:20px&quot;&gt;the final answer&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;content, stop_reason (stop · tool_use · length), token usage&lt;/div&gt;" vertex="1"><mxGeometry x="470" y="1340" width="460" height="110" as="geometry"/></mxCell><mxCell id="f12" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f1f5f9;strokeColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;done event · end&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;carries the full answer (AssistantMessage)&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;events: done&lt;/span&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="470" y="1560" width="460" height="100" as="geometry"/></mxCell><mxCell id="f13" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fef2f2;strokeColor=#dc2626;" value="&lt;b style=&quot;font-size:20px&quot;&gt;error event · end&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;an HTTP error, a network error, a bad answer …&lt;br&gt;keeps the partial answer, stop_reason = error&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;events: error&lt;/span&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="-160" y="1040" width="400" height="140" as="geometry"/></mxCell><mxCell id="n1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;stamp who wrote it&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;around the adapter, stream() puts api, provider and model on every event that carries a message&lt;/div&gt;" vertex="1"><mxGeometry x="1520" y="690" width="420" height="140" as="geometry"/></mxCell><mxCell id="n2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;abort is not here&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the agent loop stops reading and closes the stream (Part 2). No event comes from this block.&lt;/div&gt;" vertex="1"><mxGeometry x="1520" y="860" width="420" height="140" as="geometry"/></mxCell><mxCell id="n3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;reading this chart&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;blue frame: one pass for each chunk&lt;br&gt;grey frame: inside the adapter, any exception → error exit&lt;br&gt;red: an error event, the last event&lt;br&gt;grey text = the events sent out at that step&lt;/div&gt;" vertex="1"><mxGeometry x="1520" y="1340" width="420" height="170" as="geometry"/></mxCell><mxCell id="ae1"