                    <mxGeometry height="140" width="460" x="1570" y="1450" as="geometry" />
                </mxCell>
                <mxCell id="ue1" edge="1" parent="1" source="f10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeWidth=2;strokeColor=#2563eb;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="u1" value="each event, right away">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f1f5f9;strokeColor=#475569;dashed=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;stream closed · no event&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the agent loop stopped reading and closed the stream&lt;br&gt;the HTTP request ends, the model stops writing&lt;br&gt;the agent loop keeps the partial answer, stop_reason = aborted&lt;/div&gt;" vertex="1">
                    <mxGeometry height="210" width="440" x="-130" y="1490" as="geometry" />
                </mxCell>
                <mxCell id="xe1" edge="1" parent="1" source="F_chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeWidth=2;dashed=1;strokeColor=#475569;exitX=0;exitY=0.85;entryX=0.5;entryY=0;" target="x1" value="abort: the agent loop closes the stream">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="session" name="3 · Session block">
        <mxGraphModel dx="2618" dy="3323" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="i0" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=3;" value="&lt;b style=&quot;font-size:26px&quot;&gt;INPUT&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="360" width="1100" x="250" as="geometry" />
                </mxCell>
                <mxCell id="i1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;" value="&lt;b style=&quot;font-size:22px&quot;&gt;setup (given once)&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;model&lt;/b&gt; info (from a profile)&lt;br&gt;&lt;b&gt;tools&lt;/b&gt;: default = the 7 coding tools&lt;br&gt;&lt;b&gt;store&lt;/b&gt;: where finished messages are saved&lt;br&gt;&lt;b&gt;env&lt;/b&gt;, &lt;b&gt;cwd&lt;/b&gt;: where tools run (default: this machine)&lt;br&gt;&lt;b&gt;approve(call)&lt;/b&gt;: ask a human; &lt;b&gt;plugins&lt;/b&gt;&lt;br&gt;&lt;b&gt;messages&lt;/b&gt;: an old history to go on with&lt;/div&gt;" vertex="1">
                    <mxGeometry height="295" width="520" x="270" y="45" as="geometry" />
                </mxCell>
                <mxCell id="i2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;" value="&lt;b style=&quot;font-size:22px&quot;&gt;each run&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;prompt(text)&lt;/b&gt;: a new user message&lt;br&gt;&lt;b&gt;continue_()&lt;/b&gt;: go on from the history&lt;br&gt;&lt;b&gt;compact()&lt;/b&gt;: shorten the history by hand&lt;br&gt;&lt;b&gt;while it works:&lt;/b&gt;&lt;br&gt;steer(text), follow_up(text), abort()&lt;br&gt;(passed on to the agent)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="295" width="520" x="810" y="45" as="geometry" />
                </mxCell>
                <mxCell id="s0" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=5;shadow=1;fontColor=#134e4a;" value="&lt;b style=&quot;font-size:30px&quot;&gt;SESSION BLOCK · wraps one agent&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="1010" width="1136" x="250" y="410" as="geometry" />
                </mxCell>
                <mxCell id="s1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;1 · get ready, once&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the first prompt() or continue_() does it&lt;br&gt;read AGENTS.md → a prompt section&lt;br&gt;plugins: setup(api, config), then session_start&lt;/div&gt;" vertex="1">
                    <mxGeometry height="137" width="480" x="290" y="490" as="geometry" />
                </mxCell>
                <mxCell id="s2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;2 · read the prompt&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;plugins see the text first (input hook)&lt;br&gt;they may change it, or answer it themselves&lt;br&gt;they may add messages (before_agent_start)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="137" width="500" x="830" y="490" as="geometry" />
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:20px&quot;&gt;AGENT BLOCK (Part 2) · click to open&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the session fills its sockets:&lt;br&gt;system prompt = the prompt sections, built again every turn&lt;br&gt;before each model call: compact if too big, plugins may edit the view&lt;br&gt;before each tool: plugins may block it, then ask approve()&lt;br&gt;after each tool: plugins may change the result&lt;/div&gt;" link="data:page/id,agent" tooltip="open the agent block" id="s3">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fde68a;strokeColor=#b45309;strokeWidth=3;fontColor=#7c2d12;" vertex="1">
                        <mxGeometry height="183" width="1040" x="290" y="700" as="geometry" />
                    </mxCell>
                </UserObject>
                <mxCell id="s4" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;3 · on every agent event&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;message_end → store.append(message), right away&lt;br&gt;→ every subscriber, then the plugins (on_event)&lt;br&gt;tool output goes through the plugins first (hide secrets)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="480" x="290" y="980" as="geometry" />
                </mxCell>
                <mxCell id="s5" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;4 · after the run: the last answer failed?&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;too long for the model → compact once, then continue_()&lt;br&gt;a short failure (429, 5xx, network) → wait 2s, 4s, 8s, then continue_()&lt;br&gt;anything else, or abort → stop&lt;/div&gt;" vertex="1">
                    <mxGeometry height="209" width="500" x="830" y="980" as="geometry" />
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:20px&quot;&gt;open the session run as a flowchart →&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" link="data:page/id,session-flow" tooltip="open page 3a" id="s6">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#0f766e;" vertex="1">
                        <mxGeometry height="60" width="300" x="1050" y="1340" as="geometry" />
                    </mxCell>
                </UserObject>
                <mxCell id="s1_s2_1" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="s2" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="s2_s3_2" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="s3" value="agent.prompt(text, extra)">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="s3_s4_3" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="s4" value="events">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="s3_s5_4" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="s5" value="the run ends">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="o0" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=3;" value="&lt;b style=&quot;font-size:26px&quot;&gt;OUTPUT&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="1100" x="250" y="1480" as="geometry" />
                </mxCell>
                <mxCell id="o1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;" value="&lt;b style=&quot;font-size:22px&quot;&gt;events, live&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;every agent event (page 2)&lt;br&gt;compaction_start / compaction_end&lt;br&gt;auto_retry_start / auto_retry_end&lt;br&gt;plugin_error (a plugin hook raised)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="270" y="1525" as="geometry" />
                </mxCell>
                <mxCell id="o2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;" value="&lt;b style=&quot;font-size:22px&quot;&gt;the result&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the new messages of this run&lt;br&gt;the store has every finished message&lt;br&gt;so the app can load() them tomorrow&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="810" y="1525" as="geometry" />
                </mxCell>
                <mxCell id="i0_s0_5" edge="1" parent="1" source="i0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="s0" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="s0_o0_6" edge="1" parent="1" source="s0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="o0" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="pl" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;plugs in&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;store&lt;/b&gt;: JSONL file (CLI), SQLite (server)&lt;br&gt;&lt;b&gt;approve&lt;/b&gt;: a terminal prompt, or a browser button&lt;br&gt;&lt;b&gt;plugins&lt;/b&gt;: plain objects with hook methods&lt;br&gt;&lt;b&gt;stream_fn&lt;/b&gt;: ai.stream, or a fake model in tests&lt;/div&gt;" vertex="1">
                    <mxGeometry height="206" width="440" x="1450" y="700" as="geometry" />
                </mxCell>
                <mxCell id="ru" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;rules of the session&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;• the session owns one Agent; apps talk only to the session&lt;br&gt;• session.messages IS the agent's list: one history&lt;br&gt;• a plugin hook that raises: a plugin_error event, the run goes on&lt;br&gt;  (in tool_call it blocks the tool instead: fail closed)&lt;br&gt;• retry and overflow repair share one run: at most 1 compaction, 3 retries&lt;br&gt;• abort() also stops a retry wait&lt;/div&gt;" vertex="1">
                    <mxGeometry height="298" width="520" x="1450" y="1000" as="geometry" />
                </mxCell>
                <mxCell id="ub" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;used by: the apps (Part 5)&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;CLI, server; they give the store, approve and plugins&lt;/div&gt;" vertex="1">
                    <mxGeometry height="114" width="500" x="550" y="1880" as="geometry" />
                </mxCell>
                <mxCell id="o0_ub_7" edge="1" parent="1" source="o0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;dashed=1;" target="ub" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e_in" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: what goes in&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;setup&lt;/b&gt;&lt;br&gt;model: claude-sonnet-5-5 · tools: the 7 coding tools&lt;br&gt;store: ~/.simp-agent/sessions/home-me-proj/3f9a.jsonl&lt;br&gt;messages: yesterday's 6 messages (store.load())&lt;br&gt;approve: ask in the terminal · plugins: none&lt;br&gt;&lt;br&gt;&lt;b&gt;this run&lt;/b&gt;&lt;br&gt;prompt(&quot;now add tests&quot;)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="254" width="760" x="2050" y="45" as="geometry" />
                </mxCell>
                <mxCell id="e_run" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: one run, step by step&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;1 · get ready&lt;/b&gt; (first prompt today)&lt;br&gt;read AGENTS.md: &quot;use pytest&quot; → a prompt section&lt;br&gt;&lt;b&gt;2 · read the prompt&lt;/b&gt;: no plugins, the text stays&lt;br&gt;&lt;b&gt;agent block&lt;/b&gt;&lt;br&gt;turn 1: write test_fizz.py → approve? &quot;Allow write?&quot; y&lt;br&gt;turn 2: bash &quot;pytest&quot; → the model call fails: 429 rate limit&lt;br&gt;&lt;b&gt;3 · events&lt;/b&gt;: each message_end → one line in 3f9a.jsonl&lt;br&gt;&lt;b&gt;4 · after the run&lt;/b&gt;: last answer is an error, retryable&lt;br&gt;auto_retry_start (attempt 1, wait 2s) → continue_()&lt;br&gt;turn 3: bash &quot;pytest&quot; → &quot;2 passed&quot;&lt;br&gt;turn 4: text &quot;Tests added and passing.&quot; → the run ends&lt;br&gt;auto_retry_end (success)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="346" width="760" x="2050" y="339" as="geometry" />
                </mxCell>
                <mxCell id="e_out" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: what comes out&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;events&lt;/b&gt;: the agent events of 4 turns, plus&lt;br&gt;auto_retry_start, auto_retry_end&lt;br&gt;&lt;b&gt;the store&lt;/b&gt;: 3f9a.jsonl has 9 more lines&lt;br&gt;(the error answer is saved too; the model never sees it again)&lt;br&gt;&lt;b&gt;the result&lt;/b&gt;: the new messages of this run&lt;/div&gt;" vertex="1">
                    <mxGeometry height="185" width="760" x="2050" y="725" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
