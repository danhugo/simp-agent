                <mxCell id="a179" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#cbd5e1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;three loops&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b style='color:#7c3aed'&gt;outer loop&lt;/b&gt;: the model is done, but a follow_up waits → ask again&lt;br&gt;&lt;b style='color:#2563eb'&gt;inner loop&lt;/b&gt;: the model called tools, or you typed a steer → ask again&lt;br&gt;&lt;b style='color:#475569'&gt;tool loop&lt;/b&gt;: one pass for each tool call in the answer&lt;br&gt;&lt;b style=&quot;color:#1d4ed8&quot;&gt;1 2 3 4&lt;/b&gt;: the steps of page 2 (build, add the answer, tools, anything more?)&lt;br&gt;&lt;b style=&quot;color:#dc2626&quot;&gt;red&lt;/b&gt;: a way out of the run (error or abort)&lt;br&gt;grey text = the events sent out at that step&lt;/div&gt;" vertex="1">
                    <mxGeometry height="230" width="620" x="1000" y="2710" as="geometry" />
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:20px&quot;&gt;← back to the agent block&lt;/b&gt;" link="data:page/id,agent" id="back2">
                    <mxCell parent="1" style="rounded=1;html=1;fillColor=#f1f5f9;strokeColor=#64748b;" vertex="1">
                        <mxGeometry height="50" width="260" x="20" y="20" as="geometry" />
                    </mxCell>
                </UserObject>
                <mxCell id="ab1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fef2f2;strokeColor=#dc2626;dashed=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;you press Stop: abort()&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;sets the cancel flag, at any time, from outside the loop (UI, Ctrl-C, server)&lt;br&gt;• model streaming: the stream is closed at once&lt;br&gt;• waiting for approval: the answer is &quot;User denied: aborted&quot;&lt;br&gt;• tools running: the tool sees ctx.cancel and stops; checked before each tool&lt;/div&gt;" vertex="1">
                    <mxGeometry height="230" width="460" x="-300" y="560" as="geometry" />
                </mxCell>
                <mxCell id="ab2" edge="1" parent="1" source="ab1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeWidth=2;dashed=1;strokeColor=#dc2626;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="a131" value="abort() any time: close the stream">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="ab3" edge="1" parent="1" source="ab1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeWidth=2;dashed=1;strokeColor=#dc2626;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" target="a145" value="checked before each tool, and after the tools">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="ex_c0" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;examples: one path through this chart each&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;each one starts from the run on page 2 (&quot;write fizz.py and run it&quot;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;the boxes named in &quot;quotes&quot; are the boxes of this chart&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="124" width="700" x="2070" y="650" as="geometry" />
                </mxCell>
                <mxCell id="ex_c1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;1 · you press Stop while the model writes&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&quot;ask the AI block&quot;: the stream is closed at once&lt;br&gt;the partial answer &quot;I will write the&quot; is kept, stop_reason = aborted&lt;br&gt;&quot;add the answer to history&quot; → &quot;stop_reason is error or aborted?&quot; yes&lt;br&gt;→ &quot;stop the run&quot;   &lt;span style=&quot;color:#94a3b8&quot;&gt;events: turn_end, agent_end&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;the steer and follow_up queues are kept for next time&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="193" width="700" x="2070" y="804" as="geometry" />
                </mxCell>
                <mxCell id="ex_c2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;2 · you press Stop while bash runs&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;bash sees ctx.cancel (the cancel flag every tool gets): the command is killed&lt;br&gt;result: &quot;…[Command interrupted by the user after 3s]&quot;&lt;br&gt;next tool call? &quot;abort() before this tool?&quot; yes → skip the rest&lt;br&gt;&quot;was abort() set?&quot; yes&lt;br&gt;→ &quot;add an aborted answer · stop&quot;   &lt;span style=&quot;color:#94a3b8&quot;&gt;events: turn_end, agent_end&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;skipped calls get &quot;No result provided&quot; when the history is sent again&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="216" width="700" x="2070" y="1027" as="geometry" />
                </mxCell>
                <mxCell id="ex_c3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;3 · you type a steer: &quot;call it fizz2.py&quot;&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;it waits in the steer queue; the loop reads it at a safe point:&lt;br&gt;• before the next model call, or • after the tool batch&lt;br&gt;&quot;this turn had tool calls, or a steer is waiting?&quot; yes&lt;br&gt;→ &quot;turn_start · add the waiting messages&quot;: user &quot;call it fizz2.py&quot;&lt;br&gt;→ the next model call sees it   &lt;span style=&quot;color:#94a3b8&quot;&gt;a steer never cuts a tool batch&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="193" width="700" x="2070" y="1273" as="geometry" />
                </mxCell>
                <mxCell id="ex_c4" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;4 · you send a follow_up: &quot;&gt;&gt; then add tests&quot;&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;it waits until the loop would stop&lt;br&gt;turn 3 ends with text, no tool calls, no steer&lt;br&gt;&quot;a follow_up is waiting?&quot; yes → add it, next turn (outer loop)&lt;br&gt;→ the model now writes the tests, in the same run&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="700" x="2070" y="1496" as="geometry" />
                </mxCell>
                <mxCell id="ex_c5" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;5 · the answer is cut off (max tokens)&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the model writes a long write call, the vendor stops: stop_reason = length&lt;br&gt;&quot;a tool call not handled yet?&quot; yes → &quot;answer cut off?&quot; yes&lt;br&gt;→ result: &quot;Tool call was truncated (max tokens); not executed&quot;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;no tool_execution events: the cut args are never run&lt;/span&gt;&lt;br&gt;&quot;this turn had tool calls?&quot; yes → ask again; the model sees the error&lt;/div&gt;" vertex="1">
                    <mxGeometry height="216" width="700" x="2070" y="1696" as="geometry" />
                </mxCell>
                <mxCell id="ex_c6" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;6 · you deny a tool&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&quot;before_tool_call denies it?&quot; yes: you answered N to &quot;Allow bash?&quot;&lt;br&gt;→ result: &quot;User denied: denied&quot;, is_error = true&lt;br&gt;→ after_tool_call → add the result → ask again&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;the model reads the denial and picks another plan&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="700" x="2070" y="1942" as="geometry" />
                </mxCell>
                <mxCell id="ex_c7" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;7 · the vendor fails (network down)&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;AI block: one error event, stop_reason = error&lt;br&gt;&quot;stop_reason is error or aborted?&quot; yes → &quot;stop the run&quot;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;retry is not here: the session (Part 4) may wait and call continue_()&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="147" width="700" x="2070" y="2142" as="geometry" />
                </mxCell>
                <mxCell id="b1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#1d4ed8;" value="&lt;b style=&quot;font-size:20px&quot;&gt;build the request&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;prepare_next_turn: what the model may see (the session may compact here)&lt;br&gt;read the steer queue again: a steer typed now joins this call&lt;br&gt;tools changed? add a short note for the model&lt;br&gt;system prompt and API key for this call&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="460" x="470" y="420" as="geometry" />
                </mxCell>
                <mxCell id="b1e" edge="1" parent="1" source="a130" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeWidth=2;strokeColor=#1d4ed8;" target="b1" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="a169" edge="1" parent="1" source="a141" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeWidth=2;strokeColor=#1d4ed8;" target="a143" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="s1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=20;fontStyle=1;" value="1" vertex="1">
                    <mxGeometry height="44" width="44" x="945" y="430" as="geometry" />
                </mxCell>
                <mxCell id="s2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=20;fontStyle=1;" value="2" vertex="1">
                    <mxGeometry height="44" width="44" x="945" y="805" as="geometry" />
                </mxCell>
                <mxCell id="s3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=20;fontStyle=1;" value="3" vertex="1">
                    <mxGeometry height="44" width="44" x="1850" y="1063" as="geometry" />
                </mxCell>
                <mxCell id="s4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=20;fontStyle=1;" value="4" vertex="1">
                    <mxGeometry height="44" width="44" x="915" y="2246" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="ai-detail" name="1 · AI block (detail)">
        <mxGraphModel dx="3129" dy="2696" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="c2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;INPUT&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="430" width="900" x="300" as="geometry" />
                </mxCell>
                <mxCell id="c3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fde68a;strokeColor=#b45309;strokeWidth=5;shadow=1;" value="&lt;b style=&quot;font-size:30px&quot;&gt;&lt;span style=&quot;color:#7c2d12&quot;&gt;AI BLOCK · ai.stream(model, context)&lt;/span&gt;&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="1100" width="900" x="300" y="500" as="geometry" />
                </mxCell>
                <mxCell id="c4" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;OUTPUT: events&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="400" width="1000" x="250" y="1680" as="geometry" />
                </mxCell>
                <mxCell id="c5" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:26px&quot;&gt;model info&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;which model&lt;/b&gt;&lt;br&gt;id: claude-sonnet-5-5&lt;br&gt;provider: anthropic&lt;br&gt;&lt;b&gt;how to reach it&lt;/b&gt;&lt;br&gt;api: which adapter to use&lt;br&gt;base_url: the server address&lt;br&gt;api_key_env: the env var with the key&lt;br&gt;&lt;b&gt;its limits&lt;/b&gt;&lt;br&gt;max_tokens: longest reply&lt;br&gt;context_window: most it can read&lt;br&gt;&lt;b&gt;vendor quirks (compat)&lt;/b&gt;&lt;br&gt;e.g. thinking budget, reasoning effort&lt;/div&gt;" vertex="1">
                    <mxGeometry height="370" width="420" x="320" y="45" as="geometry" />
                </mxCell>
                <mxCell id="c6" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:26px&quot;&gt;context&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;system prompt&lt;/b&gt;&lt;br&gt;who the model is, what the project wants&lt;br&gt;&lt;b&gt;history (messages)&lt;/b&gt;&lt;br&gt;user: what you asked&lt;br&gt;assistant: text, thinking, tool calls&lt;br&gt;tool result: what a tool returned&lt;br&gt;&lt;b&gt;tools&lt;/b&gt;&lt;br&gt;name and description&lt;br&gt;parameters (JSON schema), e.g. read(path)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="370" width="420" x="760" y="45" as="geometry" />
                </mxCell>
                <mxCell id="c7" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:22px&quot;&gt;plugs in: one adapter per vendor&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;the adapters&lt;/b&gt;&lt;br&gt;anthropic-messages&lt;br&gt;openai-completions&lt;br&gt;openai-responses&lt;br&gt;and your own, with register_provider&lt;br&gt;&lt;b&gt;each adapter does 3 things&lt;/b&gt;&lt;br&gt;1. translate our context to vendor JSON&lt;br&gt;2. send it, open one HTTP stream&lt;br&gt;3. parse vendor chunks into our events&lt;/div&gt;" vertex="1">
                    <mxGeometry height="320" width="400" x="1280" y="500" as="geometry" />
                </mxCell>
                <mxCell id="c8" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:22px&quot;&gt;plugs in: a fake model (tests)&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;plays scripted answers in order&lt;br&gt;no network, no key&lt;br&gt;records every call it got&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="400" x="1280" y="900" as="geometry" />
                </mxCell>
                <mxCell id="c9" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;1 · pick the adapter&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;look up model info: api&lt;br&gt;&lt;b&gt;why:&lt;/b&gt; each vendor has its own API;&lt;br&gt;the app never needs to know which&lt;/div&gt;" vertex="1">
                    <mxGeometry height="140" width="420" x="560" y="570" as="geometry" />
                </mxCell>
                <mxCell id="c10" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;2 · clean the history&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;drop failed or stopped answers&lt;br&gt;give every tool call a result&lt;br&gt;thinking from another model becomes plain text&lt;br&gt;(only the same model can read its own thinking)&lt;br&gt;&lt;b&gt;why:&lt;/b&gt; a broken history makes the vendor refuse&lt;/div&gt;" vertex="1">
                    <mxGeometry height="190" width="450" x="330" y="790" as="geometry" />
                </mxCell>
                <mxCell id="c11" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;error event, sent right away&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;no adapter for this api&lt;br&gt;stop_reason = error&lt;br&gt;no api / provider / model written&lt;br&gt;(no adapter ran)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="360" x="820" y="790" as="geometry" />
                </mxCell>
                <mxCell id="c12" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;3 · the adapter talks to the vendor&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;translate&lt;/b&gt; our context to vendor JSON&lt;br&gt;&lt;b&gt;send&lt;/b&gt; it, one HTTP stream&lt;br&gt;&lt;b&gt;parse&lt;/b&gt; vendor chunks into our events&lt;br&gt;&lt;b&gt;on failure&lt;/b&gt; (no key, network, bad stream):&lt;br&gt;an error event, stop_reason = error&lt;br&gt;&lt;b&gt;so the stream never raises&lt;/b&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="210" width="460" x="420" y="1060" as="geometry" />
                </mxCell>
                <mxCell id="c13" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;4 · write who wrote the answer&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;copy 3 fields from model info into the answer:&lt;br&gt;api, provider, model&lt;br&gt;e.g. anthropic-messages · anthropic · claude-sonnet-5-5&lt;br&gt;&lt;b&gt;why:&lt;/b&gt; the answer stays in the history.&lt;br&gt;Next time, step 2 reads these fields to know&lt;br&gt;if its thinking may be sent back (same model only).&lt;br&gt;then the event goes out to OUTPUT&lt;/div&gt;" vertex="1">
                    <mxGeometry height="230" width="560" x="360" y="1340" as="geometry" />
                </mxCell>
                <mxCell id="c14" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;streamed events, chunk by chunk&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;start&lt;/b&gt;&lt;br&gt;the answer begins&lt;br&gt;&lt;b&gt;text_delta&lt;/b&gt;&lt;br&gt;a chunk of words&lt;br&gt;&lt;b&gt;thinking_start / delta / end&lt;/b&gt;&lt;br&gt;a chunk of thinking&lt;br&gt;&lt;b&gt;toolcall_start / delta / end&lt;/b&gt;&lt;br&gt;a chunk of a tool call (JSON)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="470" x="270" y="1730" as="geometry" />
                </mxCell>
                <mxCell id="c15" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;last event: done or error&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;carries the full answer (AssistantMessage)&lt;br&gt;&lt;b&gt;content&lt;/b&gt;&lt;br&gt;text, thinking, tool calls&lt;br&gt;&lt;b&gt;stop_reason&lt;/b&gt;&lt;br&gt;stop / tool_use / length / error / aborted&lt;br&gt;&lt;b&gt;usage&lt;/b&gt;&lt;br&gt;tokens in and out&lt;br&gt;&lt;b&gt;who wrote it&lt;/b&gt;&lt;br&gt;api, provider, model&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="470" x="760" y="1730" as="geometry" />
                </mxCell>
                <mxCell id="c16" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:22px&quot;&gt;used by: agent loop (Part 2)&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;shows chunks live&lt;br&gt;keeps the final answer&lt;br&gt;runs the tool calls&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="400" x="550" y="2150" as="geometry" />
