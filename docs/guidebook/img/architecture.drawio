                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:20px&quot;&gt;run the agent · click to open its flowchart&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;page 2a: the whole loop, with the session's hooks&lt;br&gt;before each model call: compact if too big&lt;br&gt;before each tool: plugins, then approve()&lt;br&gt;every event: saved (message_end) and sent on&lt;/div&gt;" link="data:page/id,loop" tooltip="open page 2a · Agent loop" id="t4">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fde68a;strokeColor=#b45309;strokeWidth=3;fontColor=#7c2d12;" vertex="1">
