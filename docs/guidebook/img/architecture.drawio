ld_plugins&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;+ redact_secrets (gets the keys)&lt;br&gt;+ plan_mode&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="640" y="910" width="580" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:22px&quot;&gt;model, plugins&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1320" y="945" width="380" height="60" as="geometry"/></mxCell><mxCell id="r5e11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#15803d;strokeWidth=3;" edge="1" parent="1" source="a5" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5e12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#15803d;strokeWidth=3;" edge="1" parent="1" source="b5" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b style=&quot;font-size:22px&quot;&gt;a tab: POST approve&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;the Allow / Deny button&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="1070" width="540" height="130" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b style=&quot;font-size:22px&quot;&gt;Run.approve(call)&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;shows the button on every tab&lt;br&gt;waits until a tab answers&lt;/div&gt;" style="