    <diagram id="server" name="5 · Server: sessions for many users">
        <mxGraphModel dx="2863" dy="2566" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="uA" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b style=&quot;font-size:24px&quot;&gt;user A · browser&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;login → a token (one per device)&lt;br&gt;POST /commands: prompt, steer, abort, &lt;b&gt;approve&lt;/b&gt;…&lt;br&gt;GET /events: one live &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt; stream per tab&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="520" x="200" as="geometry"/>
                </mxCell>
                <mxCell id="uB" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;b style=&quot;font-size:24px&quot;&gt;user B · browser&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;same, own token&lt;br&gt;sees only own sessions&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="1300" as="geometry"/>
                </mxCell>
                <mxCell id="L1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#FFFFCC;strokeColor=#000000;strokeWidth=2;fontColor=#475569;gradientColor=none;" value="&lt;b style=&quot;font-size:26px&quot;&gt;LAYER 1 · SHARED · one server for everyone&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="390" width="2000" y="230" as="geometry"/>
                </mxCell>
                <mxCell id="auth" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;auth&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;token → user id &lt;/b&gt;(not for signup / login)&lt;br&gt;session must belong to the user, else 404&lt;br&gt;the &lt;span style=&quot;color: rgb(219, 39, 119);&quot;&gt;event&lt;/span&gt; stream re-checks the token every 15 s&lt;/div&gt;" vertex="1">
                    <mxGeometry height="250" width="420" x="30" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="mgr" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;SessionManager&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;session id → Run (a cache, N at most)&lt;br&gt;drop = least recently used Run that is idle:&lt;br&gt;not busy, no open tab, no task running&lt;br&gt;idle 15 min → dropped (checked every 60 s)&lt;br&gt;none can be dropped → 503&lt;/div&gt;" vertex="1">
                    <mxGeometry height="250" width="600" x="590" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="keys" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;API keys · admin switch&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;one key per env name (model.api_key_env),&lt;br&gt;the same for all users → the get_api_key socket&lt;br&gt;hidden from the sandbox; also given to redact_secrets&lt;br&gt;paused → no model calls&lt;/div&gt;" vertex="1">
                    <mxGeometry height="250" width="692" x="1252" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="L2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:26px&quot;&gt;LAYER 2 · PER USER = only rows of data&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="260" width="2000" y="640" as="geometry"/>
                </mxCell>
                <mxCell id="store" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;store · one SQLite file&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;users, sessions, messages, &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;, usage&lt;br&gt;&lt;b&gt;every row has user_id; reads filter by it&lt;/b&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="880" x="30" y="710" as="geometry"/>
                </mxCell>
                <mxCell id="budget" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;budget · before EVERY model call&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;paused? → user revoked? →&lt;br&gt;daily $ limit? → run $ limit?&lt;br&gt;any yes → an error answer&lt;br&gt;(this is the stream_fn socket of each Run)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="880" x="1090" y="710" as="geometry"/>
                </mxCell>
                <mxCell id="L3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:26px&quot;&gt;LAYER 3 · PER SESSION · dashed = loaded on demand&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="1000" width="2000" y="980" as="geometry"/>
                </mxCell>
                <mxCell id="runA" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=3;dashed=1;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;Run · session A1 (user A)&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="880" width="1100" x="30" y="1050" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:22px&quot;&gt;AgentSession (Part 4) · click to open&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" link="data:page/id,session" id="ses">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;" vertex="1">
                        <mxGeometry height="60" width="1040" x="60" y="1110" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="sockets" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;its sockets, filled by the server&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;store&lt;/b&gt; → the Run itself: messages and &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt; share one seq&lt;br&gt;&lt;b&gt;env&lt;/b&gt; → this session's sandbox&lt;br&gt;&lt;b&gt;stream_fn&lt;/b&gt; → ai.stream + budget guard&lt;br&gt;&lt;b&gt;get_api_key&lt;/b&gt; → the shared key&lt;br&gt;&lt;b&gt;approve&lt;/b&gt; → an &quot;approval needed&quot; &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt;; any tab answers by POST&lt;br&gt;&lt;b&gt;subscribe&lt;/b&gt; → each &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt; goes to every open tab, then is saved&lt;br&gt;&amp;nbsp;&amp;nbsp;(text / thinking / tool output deltas are live only, never saved)&lt;br&gt;&lt;b&gt;plugins&lt;/b&gt; → redact_secrets, plan_mode, profile plugins&lt;br&gt;&lt;b&gt;run state&lt;/b&gt;: idle · running · waiting_approval · aborting · error&lt;/div&gt;" vertex="1">
                    <mxGeometry height="420" width="1040" x="60" y="1200" as="geometry"/>
                </mxCell>
                <mxCell id="box" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#15803d;dashed=1;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;sandbox · one per session&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;default: LocalSandbox = no container&lt;/b&gt; (refused for more than 1 user)&lt;br&gt;Docker: no network, user 1000, CPU / memory / 256 pids,&lt;br&gt;read-only root, no capabilities; files stay on the host&lt;br&gt;(workspaces/&amp;lt;ref&amp;gt;, mounted at /work); only exec runs inside&lt;/div&gt;" vertex="1">
                    <mxGeometry height="190" width="1040" x="60" y="1700" as="geometry"/>
                </mxCell>
                <mxCell id="runB" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=3;dashed=1;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;Run · session B1 (user B)&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;same shape, own container&lt;br&gt;own rows (user_id = B)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="780" x="1190" y="1050" as="geometry"/>
                </mxCell>
                <mxCell id="runB2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=3;dashed=1;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;Run · session B2 (user B)&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;many sessions → one Run each&lt;/div&gt;" vertex="1">
                    <mxGeometry height="110" width="780" x="1190" y="1240" as="geometry"/>
                </mxCell>
                <mxCell id="life" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;a Run's life&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;not loaded → &lt;b&gt;load&lt;/b&gt;: open the sandbox, read rows, &lt;b&gt;recover()&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;open approvals → aborted, cut tools get a result,&lt;br&gt;&amp;nbsp;&amp;nbsp;state → error, a &quot;server restarted&quot; note; no auto-resume&lt;br&gt;→ &lt;b&gt;in use&lt;/b&gt; → idle → &lt;b&gt;drop&lt;/b&gt; (sandbox closed, files and rows kept)&lt;br&gt;→ load again on the next request (files too)&lt;br&gt;&lt;b&gt;reconnect&lt;/b&gt;: replay &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt; after seq (Last-Event-ID),&lt;br&gt;then a snapshot: in-flight text, pending approval, title&lt;br&gt;a slow tab (1000 queued &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;) is cut off&lt;/div&gt;" vertex="1">
                    <mxGeometry height="360" width="780" x="1190" y="1390" as="geometry"/>
                </mxCell>
                <mxCell id="note5" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fffbeb;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#334155;" value="&lt;b style=&quot;font-size:24px&quot;&gt;not here&lt;/b&gt;&lt;div style=&quot;font-size:20px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;no per-user container, key or process&lt;br&gt;a user = user_id in rows&lt;/div&gt;" vertex="1">
