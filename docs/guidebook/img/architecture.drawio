    <diagram id="run" name="5a · Run (detail)"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="&lt;b style=&quot;font-size:18px&quot;&gt;← back to page 5&lt;/b&gt;" link="data:page/id,server" id="back5"><mxCell style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#f1f5f9;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="0" y="-200" width="300" height="50" as="geometry"/></mxCell></UserObject><mxCell id="title" value="&lt;b style=&quot;font-size:28px&quot;&gt;What plugs into a Run, and what the Run plugs into the session&lt;/b&gt;&lt;div style=&quot;font-size:19px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;read each row left → right: the server or the web gives something, the Run adapts it, the session gets it in one socket&lt;br&gt;(the last row goes the other way: the session sends &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt; out)&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=none;strokeColor=none;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="-130" width="1720" height="110" as="geometry"/></mxCell><mxCell id="colA" value="&lt;b style=&quot;font-size:24px&quot;&gt;FROM THE SERVER / THE WEB&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="-20" y="20" width="580" height="1500" as="geometry"/></mxCell><mxCell id="colB" value="&lt;b style=&quot;font-size:24px&quot;&gt;RUN · the adapter (one per session)&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=4;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="620" height="1500" as="geometry"/></mxCell><UserObject label="&lt;b style=&quot;font-size:24px&quot;&gt;AgentSession · its sockets&lt;/b&gt;" link="data:page/id,session" id="colC"><mxCell style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=3;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1300" y="20" width="420" height="1500" as="geometry"/></mxCell></UserObject><mxCell id="a0" value="&lt;b style=&quot;font-size:22px&quot;&gt;SQLite (shared file)&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;one table for every user&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="540" height="130" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b style=&quot;font-size:22px&quot;&gt;Run.append(msg)&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;adds user_id + seq, saves the row&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="580" height="130" as="geometry"/></mxCell><mxCell id="c0" value="&lt;b style=&quot;font-size:22px&quot;&gt;store&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1320" y="145" width="380" height="60" as="geometry"/></mxCell><mxCell id="r5e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#15803d;strokeWidth=3;" edge="1" parent="1" source="a0" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#15803d;strokeWidth=3;" edge="1" parent="1" source="b0" target="c0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b style=&quot;font-size:22px&quot;&gt;SQLite rows of this session&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;read when the Run is loaded&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="270" width="540" height="130" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b style=&quot;font-size:22px&quot;&gt;saved messages&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;turned back into messages&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="580" height="130" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b style=&quot;font-size:22px&quot;&gt;messages (history)&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1320" y="305" width="380" height="60" as="geometry"/></mxCell><mxCell id="r5e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#15803d;strokeWidth=3;" edge="1" parent="1" source="a1" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#15803d;strokeWidth=3;" edge="1" parent="1" source="b1" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b style=&quot;font-size:22px&quot;&gt;sandbox.open(session ref)&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;Local folder or a Docker container&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="430" width="540" height="130" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b style=&quot;font-size:22px&quot;&gt;passed as it is&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;the session never knows which&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="580" height="130" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;env&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1320" y="465" width="380" height="60" as="geometry"/></mxCell><mxCell id="r5e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#15803d;strokeWidth=3;" edge="1" parent="1" source="a2" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#15803d;strokeWidth=3;" edge="1" parent="1" source="b2" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b style=&quot;font-size:22px&quot;&gt;ai.stream + budget limits&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10p