                <mxCell id="a101" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;INPUT&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="1100" x="250" as="geometry"/>
                </mxCell>
                <mxCell id="a102" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:26px&quot;&gt;setup (given once)&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;system prompt&lt;/b&gt;&lt;br&gt;&lt;b&gt;model info&lt;/b&gt; (passed down to the AI block)&lt;br&gt;&lt;b&gt;tools&lt;/b&gt;: name, schema, and the code that runs it&lt;br&gt;&lt;b&gt;history&lt;/b&gt;: earlier messages, if you resume&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="270" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="a103" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:26px&quot;&gt;each run&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;prompt(text)&lt;/b&gt;: a new user message&lt;br&gt;&lt;b&gt;continue_()&lt;/b&gt;: go on from the history&lt;br&gt;&lt;b&gt;while it works:&lt;/b&gt;&lt;br&gt;steer(text): read at the start, before each model call, after each tool batch&lt;br&gt;follow_up(text): read only when it would stop&lt;br&gt;abort(): stop now&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="810" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="a104" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=5;shadow=1;fontColor=#1e3a8a;" value="&lt;b style=&quot;font-size:30px&quot;&gt;AGENT BLOCK · the loop&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="860" width="1136" x="250" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="a105" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=none;strokeColor=none;" value="&lt;b style=&quot;font-size:20px&quot;&gt;its job&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;keep asking the model until it stops calling tools&lt;br&gt;the model asks for tools, the agent runs them, and sends the results back&lt;/div&gt;" vertex="1">
                    <mxGeometry height="90" width="1040" x="280" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="a106" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:22px&quot;&gt;1 · build the request&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;history → only what the model may see&lt;br&gt;system prompt + tools&lt;br&gt;→ model info + context&lt;/div&gt;" vertex="1">
                    <mxGeometry height="140" width="460" x="290" y="570" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:22px&quot;&gt;AI BLOCK (Part 1) · click to open&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;every &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt; → straight out to OUTPUT (&lt;span style=&quot;color:#db2777&quot;&gt;message_update&lt;/span&gt;)&lt;br&gt;last &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt; (done / error) → step 2&lt;/div&gt;" link="data:page/id,ai-detail" tooltip="open the AI block detail" id="a107">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fde68a;strokeColor=#b45309;strokeWidth=3;fontColor=#7c2d12;" vertex="1">
                        <mxGeometry height="140" width="480" x="830" y="570" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="a108" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:22px&quot;&gt;2 · add the answer to the history&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;error or aborted → stop the run&lt;br&gt;no tool calls → turn ends&lt;/div&gt;" vertex="1">
                    <mxGeometry height="110" width="460" x="290" y="770" as="geometry"/>
                </mxCell>
                <mxCell id="a109" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:22px&quot;&gt;3 · run each tool call&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;abort set, or answer cut off (length) → not run&lt;br&gt;before_tool_call: may deny it&lt;br&gt;check the args, run the tool&lt;br&gt;after_tool_call: may change the result&lt;br&gt;the result goes into the history&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="460" x="290" y="940" as="geometry"/>
                </mxCell>
                <mxCell id="a110" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:22px&quot;&gt;4 · anything more to do?&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;tool results → ask the model again&lt;br&gt;a steer message → add it, ask again&lt;br&gt;else a follow_up → add it, ask again&lt;br&gt;else → the run ends&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="480" x="830" y="940" as="geometry"/>
                </mxCell>
