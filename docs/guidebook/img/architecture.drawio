    <diagram id="ai-flow" name="1a · ai.stream (flowchart)">
        <mxGraphModel dx="2629" dy="2360" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
