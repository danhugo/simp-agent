                <mxCell id="t7y_t8_14" edge="1" parent="1" source="t7y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="t8" value="wait over">
                    <mxGeometry relative="1" x="-0.3392" as="geometry">
