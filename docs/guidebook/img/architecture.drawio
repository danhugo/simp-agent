                <mxCell id="a116" edge="1" parent="1" source="a108" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1d4ed8;strokeWidth=2;exitX=1;exitY=0.8;entryX=0.3;entryY=0;" target="a110" value="no tool calls">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="a117" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;OUTPUT&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="1100" x="250" y="1330" as="geometry" />
                </mxCell>
                <mxCell id="a118" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;events, live (to subscribers)&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;agent_start / agent_end&lt;br&gt;turn_start / turn_end&lt;br&gt;message_start / message_end: one message added&lt;br&gt;message_update: one AI event, passed on&lt;br&gt;tool_execution_start / update / end&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="270" y="1375" as="geometry" />
                </mxCell>
                <mxCell id="a119" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;the result&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the new messages of this run&lt;br&gt;(user, assistant, tool results)&lt;br&gt;the history now holds them too&lt;br&gt;an error never raises: it ends as an error message&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="810" y="1375" as="geometry" />
                </mxCell>
                <mxCell id="a120" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:22px&quot;&gt;plugs in&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;env&lt;/b&gt;: where tools run (local, or other)&lt;br&gt;&lt;b&gt;get_api_key&lt;/b&gt;: the key, before every AI call&lt;br&gt;&lt;b&gt;stream_fn&lt;/b&gt;: the AI block, or a fake one for tests&lt;br&gt;&lt;b&gt;hooks&lt;/b&gt;: before / after a tool call&lt;/div&gt;" vertex="1">
                    <mxGeometry height="230" width="420" x="1520" y="715" as="geometry" />
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:22px&quot;&gt;used by: the session (Part 4) · click to open&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;it builds the Agent and fills its hooks&lt;br&gt;apps (CLI, server) talk to the session, not to the Agent&lt;/div&gt;" link="data:page/id,session" tooltip="open page 3 · Session block" id="a121"><mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" vertex="1">
                    <mxGeometry height="120" width="500" x="550" y="1730" as="geometry" />
                </mxCell>
                </UserObject><mxCell id="a122" edge="1" parent="1" source="a101" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#475569;strokeWidth=3;" target="a104" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="a123" edge="1" parent="1" source="a104" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#475569;strokeWidth=3;" target="a117" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="a124" edge="1" parent="1" source="a107" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#b45309;dashed=1;strokeWidth=2;exitX=1;exitY=0.7;entryX=0.95;entryY=0;" target="a117" value="every event, at once, as message_update">
                    <mxGeometry relative="1" x="-0.3414" as="geometry">
                        <mxPoint as="offset" />
                        <Array as="points">
                            <mxPoint x="1343.4" y="668" />
                            <mxPoint x="1343.4" y="1330" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a125" edge="1" parent="1" source="a120" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#94a3b8;dashed=1;strokeWidth=2;" target="a104" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="a126" edge="1" parent="1" source="a117" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#94a3b8;dashed=1;strokeWidth=2;" target="a121" value="">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:18px&quot;&gt;open the loop as a flowchart →&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" link="data:page/id,loop" tooltip="the full logic" id="a127">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#1d4ed8;" vertex="1">
                        <mxGeometry height="50" width="280" x="1050" y="1190" as="geometry" />
                    </mxCell>
                </UserObject>
                <mxCell id="ex_in" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: what goes in&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;setup&lt;/b&gt;&lt;br&gt;system prompt: &quot;You are a coding agent. Work in /home/me/proj.&quot;&lt;br&gt;model info: anthropic-messages · claude-sonnet-5-5&lt;br&gt;tools: read, write, edit, ls, grep, find, bash&lt;br&gt;before_tool_call: ask the user before write, edit and bash&lt;br&gt;&lt;br&gt;&lt;b&gt;this run&lt;/b&gt;&lt;br&gt;prompt(&quot;write fizz.py and run it&quot;)&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;history before: empty (a new session)&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="310" width="760" x="2020" y="45" as="geometry" />
                </mxCell>
                <mxCell id="ex_run" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: one run, turn by turn&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;turn 1&lt;/b&gt;&lt;br&gt;1 · request: system prompt + tools + [user &quot;write fizz.py and run it&quot;]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;AI block streams: &quot;I will write the file.&quot; + a tool call&lt;br&gt;2 · answer: tool call write {&quot;path&quot;: &quot;fizz.py&quot;, &quot;content&quot;: &quot;for i in …&quot;}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;stop_reason: tool_use&lt;br&gt;3 · before_tool_call: &quot;Allow write: fizz.py?&quot; → allow&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;run it → tool result: &quot;Wrote 120 chars to fizz.py&quot;&lt;br&gt;4 · it had a tool call → ask again&lt;br&gt;&lt;br&gt;&lt;b&gt;turn 2&lt;/b&gt;&lt;br&gt;1 · request: the same history + the tool result&lt;br&gt;2 · answer: tool call bash {&quot;command&quot;: &quot;python fizz.py&quot;}&lt;br&gt;3 · allow → tool result: &quot;1\n2\nFizz\n…\nFizzBuzz\n[exit code: 0]&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#94a3b8&quot;&gt;(the output streams to the screen while it runs)&lt;/span&gt;&lt;br&gt;4 · it had a tool call → ask again&lt;br&gt;&lt;br&gt;&lt;b&gt;turn 3&lt;/b&gt;&lt;br&gt;2 · answer: text &quot;fizz.py prints FizzBuzz from 1 to 15.&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;stop_reason: stop, no tool calls&lt;br&gt;4 · no tool calls, no steer, no follow_up → the run ends&lt;br&gt;&lt;br&gt;&lt;b&gt;other cases&lt;/b&gt;: Stop, steer, follow_up, cut-off answer, deny, vendor error&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;see page 2a: one example per path, next to the flowchart&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="860" width="760" x="2020" y="400" as="geometry" />
                </mxCell>
                <mxCell id="ex_out" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: what comes out&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;events, live&lt;/b&gt; (in order)&lt;br&gt;agent_start&lt;br&gt;message_start / message_end  &lt;span style=&quot;color:#94a3b8&quot;&gt;(user: the prompt)&lt;/span&gt;&lt;br&gt;turn_start&lt;br&gt;message_update × n while it streams, then message_start / message_end  &lt;span style=&quot;color:#94a3b8&quot;&gt;(answer 1)&lt;/span&gt;&lt;br&gt;tool_execution_start, tool_execution_end  &lt;span style=&quot;color:#94a3b8&quot;&gt;(write)&lt;/span&gt;&lt;br&gt;message_start / message_end  &lt;span style=&quot;color:#94a3b8&quot;&gt;(tool result)&lt;/span&gt;&lt;br&gt;turn_end&lt;br&gt;turn_start … the same for turn 2 (bash, with tool_execution_update)&lt;br&gt;turn_start … answer 3 … turn_end&lt;br&gt;agent_end&lt;br&gt;&lt;br&gt;&lt;b&gt;the result&lt;/b&gt;: 6 new messages in the history&lt;br&gt;user · assistant (write) · tool result · assistant (bash) · tool result · assistant (text)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="480" width="760" x="2020" y="1330" as="geometry" />
                </mxCell>
                <mxCell id="rules" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#475569;" value="&lt;b style=&quot;font-size:22px&quot;&gt;rules of the agent&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;• the Agent owns messages: one history list, the loop adds to it&lt;br&gt;• one run at a time: prompt() while running raises RuntimeError (use steer or follow_up)&lt;br&gt;• continue_() needs the last message to be user or tool_result&lt;br&gt;• tools run one after another, never in parallel&lt;br&gt;• each queue read gives one message (&quot;one-at-a-time&quot;), or all with &quot;all&quot;&lt;br&gt;• abort keeps the queues; each run starts with a new cancel flag&lt;br&gt;• a hook or subscriber that raises ends the run with an error message, with no events&lt;br&gt;• subscribe(fn) returns a function that unsubscribes&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="560" x="1440" y="975" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="loop" name="2a · Agent loop (flowchart)">
        <mxGraphModel dx="3904" dy="2972" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="L_outer" parent="1" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=#faf5ff;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=17;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;" value="outer loop · follow-ups" vertex="1">
                    <mxGeometry height="2430" width="1650" x="340" y="215" as="geometry" />
                </mxCell>
                <mxCell id="L_inner" parent="1" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#2563eb;fontSize=17;fontStyle=1;verticalAlign=top;align=right;spacingLeft=12;spacingRight=12;spacingTop=4;" value="inner loop · one turn per pass" vertex="1">
                    <mxGeometry height="2130" width="1580" x="360" y="245" as="geometry" />
                </mxCell>
