                    <mxGeometry height="80" width="460" x="470" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="a130" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:20px&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;turn_start&lt;/span&gt; · add the waiting messages to history&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;(steer or follow_up messages)&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;: &lt;span style=&quot;color:#db2777&quot;&gt;turn_start&lt;/span&gt;, &lt;span style=&quot;color:#db2777&quot;&gt;message_start&lt;/span&gt;/end&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="110" width="460" x="470" y="260" as="geometry"/>
