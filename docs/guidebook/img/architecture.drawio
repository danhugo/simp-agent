                <mxCell id="c4" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;OUTPUT: events&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="400" width="1000" x="250" y="1680" as="geometry"/>
                </mxCell>
                <mxCell id="c5" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:26px&quot;&gt;model info&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;which model&lt;/b&gt;&lt;br&gt;id: claude-sonnet-5-5&lt;br&gt;provider: anthropic&lt;br&gt;&lt;b&gt;how to reach it&lt;/b&gt;&lt;br&gt;api: which adapter to use&lt;br&gt;base_url: the server address&lt;br&gt;api_key_env: the env var with the key&lt;br&gt;&lt;b&gt;its limits&lt;/b&gt;&lt;br&gt;max_tokens: longest reply&lt;br&gt;context_window: most it can read&lt;br&gt;&lt;b&gt;vendor quirks (compat)&lt;/b&gt;&lt;br&gt;e.g. thinking budget, reasoning effort&lt;/div&gt;" vertex="1">
                    <mxGeometry height="370" width="420" x="320" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="c6" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:26px&quot;&gt;context&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;system prompt&lt;/b&gt;&lt;br&gt;who the model is, what the project wants&lt;br&gt;&lt;b&gt;history (messages)&lt;/b&gt;&lt;br&gt;user: what you asked&lt;br&gt;assistant: text, thinking, tool calls&lt;br&gt;tool result: what a tool returned&lt;br&gt;&lt;b&gt;tools&lt;/b&gt;&lt;br&gt;name and description&lt;br&gt;parameters (JSON schema), e.g. read(path)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="370" width="420" x="760" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="c7" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:22px&quot;&gt;plugs in: one adapter per vendor&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;the adapters&lt;/b&gt;&lt;br&gt;anthropic-messages&lt;br&gt;openai-completions&lt;br&gt;openai-responses&lt;br&gt;and your own, with register_provider&lt;br&gt;&lt;b&gt;each adapter does 3 things&lt;/b&gt;&lt;br&gt;1. translate our context to vendor JSON&lt;br&gt;2. send it, open one HTTP stream&lt;br&gt;3. parse vendor chunks into our events&lt;/div&gt;" vertex="1">
                    <mxGeometry height="320" width="400" x="1280" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="c8" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:22px&quot;&gt;plugs in: a fake model (tests)&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;plays scripted answers in order&lt;br&gt;no network, no key&lt;br&gt;records every call it got&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="400" x="1280" y="900" as="geometry"/>
                </mxCell>
                <mxCell id="c9" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;1 · pick the adapter&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;look up model info: api&lt;br&gt;&lt;b&gt;why:&lt;/b&gt; each vendor has its own API;&lt;br&gt;the app never needs to know which&lt;/div&gt;" vertex="1">
                    <mxGeometry height="140" width="420" x="560" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="c10" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;2 · clean the history&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;drop failed or stopped answers&lt;br&gt;give every tool call a result&lt;br&gt;thinking from another model becomes plain text&lt;br&gt;(only the same model can read its own thinking)&lt;br&gt;&lt;b&gt;why:&lt;/b&gt; a broken history makes the vendor refuse&lt;/div&gt;" vertex="1">
                    <mxGeometry height="190" width="450" x="330" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="c11" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;error event, sent right away&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;no adapter for this api&lt;br&gt;stop_reason = error&lt;br&gt;no api / provider / model written&lt;br&gt;(no adapter ran)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="360" x="820" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="c12" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;3 · the adapter talks to the vendor&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;translate&lt;/b&gt; our context to vendor JSON&lt;br&gt;&lt;b&gt;send&lt;/b&gt; it, one HTTP stream&lt;br&gt;&lt;b&gt;parse&lt;/b&gt; vendor chunks into our events&lt;br&gt;&lt;b&gt;on failure&lt;/b&gt; (no key, network, bad stream):&lt;br&gt;an error event, stop_reason = error&lt;br&gt;&lt;b&gt;so the stream never raises&lt;/b&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="210" width="460" x="420" y="1060" as="geometry"/>
                </mxCell>
                <mxCell id="c13" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontColor=#1c1917;" value="&lt;b style=&quot;font-size:22px&quot;&gt;4 · write who wrote the answer&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;copy 3 fields from model info into the answer:&lt;br&gt;api, provider, model&lt;br&gt;e.g. anthropic-messages · anthropic · claude-sonnet-5-5&lt;br&gt;&lt;b&gt;why:&lt;/b&gt; the answer stays in the history.&lt;br&gt;Next time, step 2 reads these fields to know&lt;br&gt;if its thinking may be sent back (same model only).&lt;br&gt;then the event goes out to OUTPUT&lt;/div&gt;" vertex="1">
                    <mxGeometry height="230" width="560" x="360" y="1340" as="geometry"/>
                </mxCell>
                <mxCell id="c14" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;streamed events, chunk by chunk&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;start&lt;/b&gt;&lt;br&gt;the answer begins&lt;br&gt;&lt;b&gt;text_delta&lt;/b&gt;&lt;br&gt;a chunk of words&lt;br&gt;&lt;b&gt;thinking_start / delta / end&lt;/b&gt;&lt;br&gt;a chunk of thinking&lt;br&gt;&lt;b&gt;toolcall_start / delta / end&lt;/b&gt;&lt;br&gt;a chunk of a tool call (JSON)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="470" x="270" y="1730" as="geometry"/>
                </mxCell>
                <mxCell id="c15" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;last event: done or error&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;carries the full answer (AssistantMessage)&lt;br&gt;&lt;b&gt;content&lt;/b&gt;&lt;br&gt;text, thinking, tool calls&lt;br&gt;&lt;b&gt;stop_reason&lt;/b&gt;&lt;br&gt;stop / tool_use / length / error / aborted&lt;br&gt;&lt;b&gt;usage&lt;/b&gt;&lt;br&gt;tokens in and out&lt;br&gt;&lt;b&gt;who wrote it&lt;/b&gt;&lt;br&gt;api, provider, model&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="470" x="760" y="1730" as="geometry"/>
                </mxCell>
                <mxCell id="c16" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:22px&quot;&gt;used by: agent loop (Part 2)&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;shows chunks live&lt;br&gt;keeps the final answer&lt;br&gt;runs the tool calls&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="400" x="550" y="2150" as="geometry"/>
                </mxCell>
                <mxCell id="c17" edge="1" parent="1" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#475569;strokeWidth=3;" target="c3" value="model info + context">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c18" edge="1" parent="1" source="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1e3a8a;strokeWidth=2;" target="c10" value="found">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c19" edge="1" parent="1" source="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#dc2626;strokeWidth=2;" target="c11" value="no adapter">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c20" edge="1" parent="1" source="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1e3a8a;strokeWidth=2;" target="c12" value="a clean copy">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c21" edge="1" parent="1" source="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1e3a8a;strokeWidth=2;" target="c13" value="one event (a chunk, done or error)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c22" edge="1" parent="1" source="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#2563eb;dashed=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" target="c12" value="next chunk, until done or error">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c23" edge="1" parent="1" source="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#94a3b8;dashed=1;strokeWidth=2;entryX=1;entryY=0.3;" target="c12" value="picked by api">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c24" edge="1" parent="1" source="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#94a3b8;dashed=1;strokeWidth=2;entryX=1;entryY=0.7;" target="c12" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c25" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#475569;strokeWidth=3;" target="c4" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c26" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#94a3b8;dashed=1;strokeWidth=2;" target="c16" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c27" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: the context sent in&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;system_prompt&lt;/b&gt;&lt;br&gt;&quot;You are a coding agent. Work in /home/me/proj.&quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;messages&lt;/b&gt; (the history)&lt;br&gt;1. user: &quot;what does fizz.py do?&quot;&lt;br&gt;2. assistant (anthropic-messages · anthropic · claude-sonnet-5-5)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;thinking: &quot;I should read the file&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;tool call: read {&quot;path&quot;: &quot;fizz.py&quot;}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;stop_reason: tool_use&lt;br&gt;3. tool result (read): &quot;for i in range(1, 16): ...&quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;tools&lt;/b&gt;&lt;br&gt;read(path): &quot;Read a file&quot;&lt;br&gt;write(path, content): &quot;Write a file&quot;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;so now the model must answer the user,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;using what the tool returned&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="620" width="700" x="1760" as="geometry"/>
                </mxCell>
                <mxCell id="c28" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: the events that come out&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;1. start&lt;/b&gt; &lt;span style=&quot;color:#94a3b8&quot;&gt;(an empty answer to fill)&lt;/span&gt;&lt;br&gt;&lt;b&gt;2. thinking_start&lt;/b&gt;&lt;br&gt;&lt;b&gt;3. thinking_delta&lt;/b&gt; &quot;The loop prints&quot;&lt;br&gt;&lt;b&gt;4. thinking_delta&lt;/b&gt; &quot; FizzBuzz up to 15.&quot;&lt;br&gt;&lt;b&gt;5. thinking_end&lt;/b&gt;&lt;br&gt;&lt;b&gt;6. text_delta&lt;/b&gt; &quot;fizz.py prints&quot;&lt;br&gt;&lt;b&gt;7. text_delta&lt;/b&gt; &quot; FizzBuzz from 1 to 15.&quot;&lt;br&gt;&lt;b&gt;8. done&lt;/b&gt; &lt;span style=&quot;color:#94a3b8&quot;&gt;(the full answer)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;content: [thinking &quot;The loop prints FizzBuzz up to 15.&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;text &quot;fizz.py prints FizzBuzz from 1 to 15.&quot;]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;stop_reason: stop&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;usage: input 812, output 64&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;api · provider · model: anthropic-messages · anthropic · claude-sonnet-5-5&lt;br&gt;&lt;br&gt;&lt;b&gt;if the model wants a tool instead&lt;/b&gt; (like answer 2 above):&lt;br&gt;&lt;b&gt;toolcall_start&lt;/b&gt; name: &quot;read&quot;&lt;br&gt;&lt;b&gt;toolcall_delta&lt;/b&gt; &quot;{\&quot;path\&quot;: &quot;&lt;br&gt;&lt;b&gt;toolcall_delta&lt;/b&gt; &quot;\&quot;fizz.py\&quot;}&quot;&lt;br&gt;&lt;b&gt;toolcall_end&lt;/b&gt;&lt;br&gt;&lt;b&gt;done&lt;/b&gt; stop_reason: tool_use&lt;br&gt;&lt;br&gt;&lt;b&gt;if it fails&lt;/b&gt; (e.g. network down):&lt;br&gt;start … then &lt;b&gt;error&lt;/b&gt;, stop_reason: error, error: &quot;Connection error&quot;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="860" width="760" x="1760" y="1180" as="geometry"/>
                </mxCell>
                <mxCell id="c29" edge="1" parent="1" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#94a3b8;dashed=1;strokeWidth=2;" target="c27" value="example">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c30" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#94a3b8;dashed=1;strokeWidth=2;" target="c28" value="example">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:20px&quot;&gt;← back to the agent block&lt;/b&gt;" link="data:page/id,agent" id="back">
                    <mxCell parent="1" style="rounded=1;html=1;fillColor=#f1f5f9;strokeColor=#64748b;" vertex="1">
                        <mxGeometry height="50" width="260" x="20" y="20" as="geometry"/>
                    </mxCell>
                </UserObject>
            </root>
        </mxGraphModel>
