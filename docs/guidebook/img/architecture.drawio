                    <mxGeometry height="135" width="460" x="1570" y="836" as="geometry" />
                </mxCell>
                <mxCell id="n2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;abort comes from outside&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;no cancel flag in this block: the agent loop waits for the next chunk and the cancel flag at the same time, and closes the stream if cancel comes first (grey exit)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="190" width="460" x="1570" y="1011" as="geometry" />
                </mxCell>
                <mxCell id="n3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;reading this chart&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;blue frame: one pass for each chunk&lt;br&gt;grey frame: inside the adapter, any exception → error exit&lt;br&gt;red: an error event, the last event&lt;br&gt;grey text = the events sent out at that step&lt;/div&gt;" vertex="1">
                    <mxGeometry height="181" width="460" x="1570" y="1235" as="geometry" />
