                <mxCell id="a115" edge="1" parent="1" source="a110" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#2563eb;dashed=1;strokeWidth=2;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" target="a106" value="yes: next turn">
                    <mxGeometry relative="1" as="geometry" />
