                <mxCell id="a171" edge="1" parent="1" source="a144" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#2563eb;dashed=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" target="a135" value="next tool call">
