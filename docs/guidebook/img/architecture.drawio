                <mxCell id="pc_t1b" edge="1" parent="1" source="pc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="t1b" value="prompt(text)">
