                </mxCell>
                <mxCell id="t7y_t11_19" edge="1" parent="1" source="t7y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;dashed=1;strokeColor=#dc2626;" target="t11" value="Stop pressed">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;reading this chart&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;green: what the session does&lt;br&gt;yellow: the agent block, click to open&lt;br&gt;red: the run stops with an error&lt;br&gt;teal frame: the retry loop, one pass per failed run&lt;br&gt;grey text = the &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt; sent out at that step&lt;/div&gt;" vertex="1">
                    <mxGeometry height="206" width="460" x="2020" as="geometry"/>
                </mxCell>
                <mxCell id="n2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;one run, two repairs&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;a too-long error → &lt;span style=&quot;color:#0369a1&quot;&gt;compact&lt;/span&gt; once (at most once per run)&lt;br&gt;a short failure → wait and retry (at most 3 times)&lt;br&gt;both end with continue_(), so the agent goes on where it stopped&lt;/div&gt;" vertex="1">
                    <mxGeometry height="206" width="460" x="2020" y="246" as="geometry"/>
                </mxCell>
                <mxCell id="n3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;not drawn here&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the hooks inside the agent run are on page 2a&lt;br&gt;saving: every &lt;span style=&quot;color:#db2777&quot;&gt;message_end&lt;/span&gt; is saved right away, so a crash loses at most the message being written&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="460" x="2020" y="662" as="geometry"/>
                </mxCell>
                <mxCell id="x1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;1 · a normal run&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;prompt(&quot;now add tests&quot;) → get ready (first time) → no plugin answers&lt;br&gt;→ run the agent → last answer ok → the run ends&lt;/div&gt;" vertex="1">
                    <mxGeometry height="114" width="720" x="2020" y="902" as="geometry"/>
                </mxCell>
                <mxCell id="x2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;2 · a 429 rate limit&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;last answer: error &quot;429 Too Many Requests&quot;&lt;br&gt;&quot;is an error?&quot; yes → &quot;too long?&quot; no → &quot;short failure?&quot; yes&lt;br&gt;→ &lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_start&lt;/span&gt;, wait 2s → continue_() → ok&lt;br&gt;→ &quot;the run ends&quot;: &lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_end&lt;/span&gt; (success)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="720" x="2020" y="1046" as="geometry"/>
                </mxCell>
                <mxCell id="x3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;3 · too long for the model&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;last answer: error &quot;prompt is too long: 210000 tokens&quot;&lt;br&gt;&quot;too long?&quot; yes → &lt;span style=&quot;color:#0369a1&quot;&gt;compact&lt;/span&gt; once → continue_() → ok&lt;br&gt;a second &quot;too long&quot; in the same run → stop with the error&lt;/div&gt;" vertex="1">
                    <mxGeometry height="137" width="720" x="2020" y="1236" as="geometry"/>
                </mxCell>
                <mxCell id="x4" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;4 · Stop during the wait&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;429 → wait 4s (attempt 2) → you press Stop&lt;br&gt;→ &quot;stop · aborted during the wait&quot; → &lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_end&lt;/span&gt; (no success)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="114" width="720" x="2020" y="1403" as="geometry"/>
                </mxCell>
                <mxCell id="x5" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;5 · a fatal error&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;no API key: error_kind = fatal&lt;br&gt;&quot;short failure?&quot; no → &quot;stop with the error&quot;, no retry&lt;/div&gt;" vertex="1">
                    <mxGeometry height="114" width="720" x="2020" y="1547" as="geometry"/>
                </mxCell>
                <mxCell id="x6" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#475569;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;6 · a plugin handles it&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;prompt(&quot;/stats&quot;) → a stats plugin prints the token count, says &quot;handled&quot;&lt;br&gt;→ &quot;stop · the model is not called&quot;: no model call at all&lt;/div&gt;" vertex="1">
                    <mxGeometry height="114" width="720" x="2020" y="1691" as="geometry"/>
                </mxCell>
                <mxCell id="t11_t9" edge="1" parent="1" source="t11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#64748b;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="t9" value="then the run ends">
                    <mxGeometry relative="1" x="-0.1826" as="geometry">
                        <Array as="points">
                            <mxPoint x="1814" y="1741.5"/>
                            <mxPoint x="1814" y="2119.5"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t0note" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fffbeb;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#334155;" value="&lt;b style=&quot;font-size:20px&quot;&gt;note · where continue_() comes from&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;prompt(text)&lt;/b&gt;: the app has new text from the user&lt;br&gt;&lt;b&gt;continue_()&lt;/b&gt;: no new text, go on from the history&lt;br&gt;&lt;br&gt;&lt;b&gt;first check inside continue_()&lt;/b&gt;:&lt;br&gt;skip &lt;span style=&quot;color:#0369a1&quot;&gt;compaction&lt;/span&gt; / custom entries and error answers,&lt;br&gt;the last message must be &lt;b&gt;user&lt;/b&gt; or &lt;b&gt;tool_result&lt;/b&gt;&lt;br&gt;(the model still owes an answer); a normal assistant answer → ValueError &quot;Cannot continue&quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;who calls it&lt;/b&gt;&lt;br&gt;• the session itself, in the retry loop (most common)&lt;br&gt;• an app that resumes a run cut off in the middle&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;the CLI: simp -c opens the chat and waits for you; it does not call continue_()&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;example&lt;/b&gt;&lt;br&gt;history: user &quot;write fizz.py&quot; → assistant: tool call write → tool result &quot;ok&quot;&lt;br&gt;the app crashes before the next model call&lt;br&gt;later: continue_() → last is tool_result → OK, the model answers &quot;Done, fizz.py written.&quot;&lt;br&gt;call continue_() again → last is assistant → &quot;Cannot continue&quot;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="520" width="740" x="-786" y="-264" as="geometry"/>
                </mxCell>
                <mxCell id="t0note_e" edge="1" parent="1" source="t0note" style="endArrow=none;dashed=1;strokeColor=#94a3b8;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="t0" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t1b" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;input hooks, plugin by plugin&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;each plugin does its job, then returns:&lt;br&gt;&lt;b&gt;nothing&lt;/b&gt; or &lt;b&gt;a new text (the next plugin gets it)&lt;/b&gt; · or &lt;b&gt;&quot;handled&quot;&lt;/b&gt;&lt;br&gt;the first &quot;handled&quot; stops the loop: later plugins are skipped&lt;/div&gt;" vertex="1">
                    <mxGeometry height="120" width="460" x="470" y="361" as="geometry"/>
                </mxCell>
                <mxCell id="t1b_t2" edge="1" parent="1" source="t1b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="t2" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t4out" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fdf2f8;dashed=1;strokeWidth=2;fontColor=#334155;strokeColor=#db2777;" value="&lt;b style=&quot;font-size:20px&quot;&gt;sent out while the agent runs&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;to the store&lt;/b&gt;: every &lt;span style=&quot;color:#db2777&quot;&gt;message_end&lt;/span&gt; → store.append(message), right away&lt;br&gt;&lt;b&gt;to subscribers (the app), then plugins' on_event&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;every agent &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt; (page 2): turn_*, message_*, &lt;span style=&quot;color:#db2777&quot;&gt;message_update&lt;/span&gt; (AI chunks), tool_execution_*&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#db2777&quot;&gt;tool_execution_update&lt;/span&gt; goes through plugins' tool_update first (hide secrets)&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#0369a1&quot;&gt;compaction_start&lt;/span&gt; / &lt;span style=&quot;color:#0369a1&quot;&gt;compaction_end&lt;/span&gt;: the &quot;too big?&quot; check before a model call&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(the summary is saved too: &lt;span style=&quot;color:#db2777&quot;&gt;message_end&lt;/span&gt; with a &lt;span style=&quot;color:#0369a1&quot;&gt;CompactionEntry&lt;/span&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;plugin_error: a plugin hook raised&lt;br&gt;&amp;nbsp;&amp;nbsp;plugin &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;: api.emit(...), api.append_entry(...) → &lt;span style=&quot;color:#db2777&quot;&gt;message_end&lt;/span&gt;&lt;br&gt;&lt;b&gt;to the human&lt;/b&gt;: approve(call) for bash / write / edit, the run waits for the answer&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;after the run: auto_retry_*, and compaction_* for an overflow&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="700" x="1279" y="731" as="geometry"/>
                </mxCell>
                <mxCell id="t4_out" edge="1" parent="1" source="t4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeWidth=2;fontSize=14;fontStyle=2;strokeColor=#db2777;fontColor=#db2777;" target="t4out" value="&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;, live">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t1y_t1b" edge="1" parent="1" source="t1y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="pc" value="then">
                    <mxGeometry relative="1" as="geometry"/>
