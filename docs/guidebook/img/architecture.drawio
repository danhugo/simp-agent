                    <mxGeometry height="295" width="520" x="810" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="s0" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=5;shadow=1;fontColor=#134e4a;" value="&lt;b style=&quot;font-size:30px&quot;&gt;SESSION BLOCK · wraps one agent&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="1010" width="1136" x="250" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="s1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;1 · get ready, once&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the first prompt() or continue_() does it&lt;br&gt;read AGENTS.md → a prompt section&lt;br&gt;plugins: setup(api, config), then session_start&lt;/div&gt;" vertex="1">
                    <mxGeometry height="137" width="480" x="290" y="490" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;2 · read the prompt&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;plugins see the text first (input hook)&lt;br&gt;they may change it, or answer it themselves&lt;br&gt;they may add messages (before_agent_start)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="137" width="500" x="830" y="490" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:20px&quot;&gt;AGENT BLOCK (Part 2) · click to open&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the session fills its sockets:&lt;br&gt;system prompt = the prompt sections, built again every turn&lt;br&gt;before each model call: &lt;span style=&quot;color:#0369a1&quot;&gt;compact&lt;/span&gt; if too big, plugins may edit the view&lt;br&gt;before each tool: plugins may block it or change its args,&lt;br&gt;then approve() asks a human, only for bash / write / edit&lt;br&gt;(not again once you answered &quot;always&quot;)&lt;br&gt;after each tool: plugins may change the result&lt;/div&gt;" link="data:page/id,agent" tooltip="open the agent block" id="s3">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fde68a;strokeColor=#b45309;strokeWidth=3;fontColor=#7c2d12;" vertex="1">
                        <mxGeometry height="183" width="1040" x="290" y="700" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="s4" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#db2777;" value="&lt;b style=&quot;font-size:20px&quot;&gt;3 · on every agent &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt;&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;message_end&lt;/span&gt; → store.append(message), right away&lt;br&gt;→ every subscriber, then the plugins (on_event)&lt;br&gt;tool output goes through the plugins first (hide secrets)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="480" x="290" y="980" as="geometry"/>
                </mxCell>
                <mxCell id="s5" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;4 · after the run: the last answer failed?&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;too long for the model → &lt;span style=&quot;color:#0369a1&quot;&gt;compact&lt;/span&gt; once, then continue_()&lt;br&gt;a short failure (429, 5xx, network) → wait 2s, 4s, 8s, then continue_()&lt;br&gt;anything else, or abort → stop&lt;/div&gt;" vertex="1">
                    <mxGeometry height="209" width="500" x="830" y="980" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:20px&quot;&gt;open the session run as a flowchart →&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" link="data:page/id,session-flow" tooltip="open page 4a" id="s6">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#0f766e;" vertex="1">
                        <mxGeometry height="60" width="300" x="1050" y="1340" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="s1_s2_1" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="s2" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s2_s3_2" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="s3" value="agent.prompt(text, extra)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s3_s4_3" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;strokeWidth=2;strokeColor=#db2777;fontColor=#db2777;" target="s4" value="&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s3_s5_4" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="s5" value="the run ends">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="o0" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=3;" value="&lt;b style=&quot;font-size:26px&quot;&gt;OUTPUT&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="1100" x="250" y="1480" as="geometry"/>
                </mxCell>
                <mxCell id="o1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fdf2f8;strokeColor=#db2777;" value="&lt;b style=&quot;font-size:22px&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;, live&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;every agent &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt; (page 2)&lt;br&gt;&lt;span style=&quot;color:#0369a1&quot;&gt;compaction_start&lt;/span&gt; / &lt;span style=&quot;color:#0369a1&quot;&gt;compaction_end&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_start&lt;/span&gt; / &lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_end&lt;/span&gt;&lt;br&gt;plugin_error (a plugin hook raised)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="270" y="1525" as="geometry"/>
                </mxCell>
                <mxCell id="o2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;" value="&lt;b style=&quot;font-size:22px&quot;&gt;the result&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the new messages of this run&lt;br&gt;the store has every finished message&lt;br&gt;so the app can load() them tomorrow&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="810" y="1525" as="geometry"/>
                </mxCell>
                <mxCell id="i0_s0_5" edge="1" parent="1" source="i0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="s0" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s0_o0_6" edge="1" parent="1" source="s0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;" target="o0" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pl" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;plugs in&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;store&lt;/b&gt;: JSONL file (CLI), SQLite (server)&lt;br&gt;&lt;b&gt;approve&lt;/b&gt;: a terminal prompt, or a browser button&lt;br&gt;&lt;b&gt;plugins&lt;/b&gt;: plain objects with hook methods&lt;br&gt;  hooks: setup, session_start, input, before_agent_start, context,&lt;br&gt;  tool_call, tool_update, tool_result, on_event, session_shutdown&lt;br&gt;  api: add/remove tools and prompt sections, set_model,&lt;br&gt;  send_message, abort, append_entry (saved, never sent to the model)&lt;br&gt;&lt;b&gt;stream_fn&lt;/b&gt;: ai.stream, or a fake model in tests&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="440" x="1450" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="ru" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;rules of the session&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;• the session owns one Agent; apps talk only to the session&lt;br&gt;• session.messages IS the agent's list: one history&lt;br&gt;• a plugin hook that raises: a plugin_error &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt;, the run goes on&lt;br&gt;  (in tool_call it blocks the tool instead: fail closed)&lt;br&gt;• retry and overflow repair share one run: at most 1 overflow &lt;span style=&quot;color:#0369a1&quot;&gt;compaction&lt;/span&gt;, 3 retries&lt;br&gt;  (the &quot;too big?&quot; check before each model call is separate, any number of times)&lt;br&gt;• abort() also stops a retry wait&lt;/div&gt;" vertex="1">
                    <mxGeometry height="330" width="520" x="1450" y="1060" as="geometry"/>
                </mxCell>
                <mxCell id="ub" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;used by: the apps (Part 5)&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;CLI, server; they give the store, approve and plugins&lt;/div&gt;" vertex="1">
                    <mxGeometry height="114" width="500" x="550" y="1880" as="geometry"/>
                </mxCell>
                <mxCell id="o0_ub_7" edge="1" parent="1" source="o0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#0f766e;strokeWidth=2;dashed=1;" target="ub" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_in" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: what goes in&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;setup&lt;/b&gt;&lt;br&gt;model: claude-sonnet-5-5 · tools: the 7 coding tools&lt;br&gt;store: ~/.simp-agent/sessions/home-me-proj/3f9a.jsonl&lt;br&gt;messages: yesterday's 6 messages (store.load())&lt;br&gt;approve: ask in the terminal · plugins: none&lt;br&gt;&lt;br&gt;&lt;b&gt;this run&lt;/b&gt;&lt;br&gt;prompt(&quot;now add tests&quot;)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="254" width="760" x="2050" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="e_run" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: one run, step by step&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;1 · get ready&lt;/b&gt; (first prompt today)&lt;br&gt;read AGENTS.md: &quot;use pytest&quot; → a prompt section&lt;br&gt;&lt;b&gt;2 · read the prompt&lt;/b&gt;: no plugins, the text stays&lt;br&gt;&lt;b&gt;agent block&lt;/b&gt;&lt;br&gt;turn 1: write test_fizz.py → approve? &quot;Allow write?&quot; y&lt;br&gt;turn 2: bash &quot;pytest&quot; → the model call fails: 429 rate limit&lt;br&gt;&lt;b&gt;3 · &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;&lt;/b&gt;: each &lt;span style=&quot;color:#db2777&quot;&gt;message_end&lt;/span&gt; → one line in 3f9a.jsonl&lt;br&gt;&lt;b&gt;4 · after the run&lt;/b&gt;: last answer is an error, retryable&lt;br&gt;&lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_start&lt;/span&gt; (attempt 1, wait 2s) → continue_()&lt;br&gt;turn 3: bash &quot;pytest&quot; → &quot;2 passed&quot;&lt;br&gt;turn 4: text &quot;Tests added and passing.&quot; → the run ends&lt;br&gt;&lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_end&lt;/span&gt; (success)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="346" width="760" x="2050" y="339" as="geometry"/>
                </mxCell>
                <mxCell id="e_out" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:22px&quot;&gt;example: what comes out&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;&lt;/b&gt;: the agent &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt; of 4 turns, plus&lt;br&gt;&lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_start&lt;/span&gt;, &lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_end&lt;/span&gt;&lt;br&gt;&lt;b&gt;the store&lt;/b&gt;: 3f9a.jsonl has 9 more lines&lt;br&gt;(the error answer is saved too; the model never sees it again)&lt;br&gt;&lt;b&gt;the result&lt;/b&gt;: the new messages of this run&lt;/div&gt;" vertex="1">
                    <mxGeometry height="185" width="760" x="2050" y="725" as="geometry"/>
                </mxCell>
                <mxCell id="cp" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;the coding part plugs in (Part 3)&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the session imports from coding/:&lt;br&gt;• TOOLS: the 7 coding tools (default tools)&lt;br&gt;• the coding prompt: prompt section &quot;coding&quot;, order 0&lt;br&gt;• AGENTS.md / CLAUDE.md of the project: section &quot;context_file&quot;, order 10&lt;br&gt;give system_prompt= → it replaces the coding prompt,&lt;br&gt;and no AGENTS.md is read&lt;br&gt;&lt;br&gt;&lt;b&gt;prompt sections&lt;/b&gt;: sorted by order (0, 10, plugins 100),&lt;br&gt;joined into the system prompt, built again every turn&lt;/div&gt;" vertex="1">
                    <mxGeometry height="300" width="560" x="1450" y="1420" as="geometry"/>
                </mxCell>
                <mxCell id="cp_s3" edge="1" parent="1" source="cp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94a3b8;dashed=1;strokeWidth=2;" target="s0" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="plughooks" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#334155;" value="&lt;b style=&quot;font-size:20px&quot;&gt;plugins &amp;amp; hooks&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;hook&lt;/b&gt; = a method with a fixed name. The session calls it at a fixed moment.&lt;br&gt;&lt;b&gt;plugin&lt;/b&gt; = a plain object with some of these methods. It writes only the ones it needs.&lt;br&gt;The session calls each plugin in list order, and each one gets the last one's output.&lt;br&gt;&lt;br&gt;&lt;b&gt;when → hook&lt;/b&gt;&lt;br&gt;first run → setup(api, config), session_start&lt;br&gt;new text → input (change it, or handled: no model call), before_agent_start (add messages)&lt;br&gt;before each model call → context (edit what the model sees)&lt;br&gt;each tool → tool_call (block / change args), tool_update (hide secrets), tool_result (change it)&lt;br&gt;each &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt; → on_event · shutdown() → session_shutdown&lt;br&gt;&lt;br&gt;&lt;b&gt;from Part 2&lt;/b&gt;: the agent has only 2 hooks, before_tool_call / after_tool_call (plain functions).&lt;br&gt;The session plugs its own functions in there; inside, they call every plugin's tool_call / tool_result,&lt;br&gt;then approve().&lt;br&gt;&lt;br&gt;&lt;b&gt;the other way&lt;/b&gt;: setup gets a PluginAPI, so a plugin can add tools and prompt sections,&lt;br&gt;send a message, set the model, abort.&lt;br&gt;A hook that raises → a plugin_error &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt;; the run goes on (tool_call: the tool is blocked).&lt;br&gt;&lt;br&gt;&lt;b&gt;example&lt;/b&gt;: a plugin with one hook&lt;br&gt;&lt;span style=&quot;font-family:Menlo&quot;&gt;class HideKeys:&lt;br&gt;&amp;nbsp;&amp;nbsp;def tool_update(self, call, text):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return text.replace(KEY, &quot;***&quot;)&lt;/span&gt;&lt;br&gt;AgentSession(..., plugins=[HideKeys()]) → bash output shows *** instead of the key&lt;/div&gt;" vertex="1">
                    <mxGeometry height="640" width="760" x="1450" y="1780" as="geometry"/>
                </mxCell>
                <mxCell id="plughooks_e" edge="1" parent="1" source="plughooks" style="endArrow=none;dashed=1;strokeColor=#94a3b8;strokeWidth=2;" target="pl" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="session-flow" name="4a · Session run (flowchart)">
        <mxGraphModel dx="2750" dy="2115" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="F_retry" parent="1" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=#f0fdfa;strokeColor=#0f766e;fontColor=#0f766e;fontSize=17;fontStyle=1;verticalAlign=top;align=right;spacingLeft=12;spacingRight=12;spacingTop=4;" value="retry loop · after each failed run" vertex="1">
                    <mxGeometry height="837" width="1180" x="380" y="1164" as="geometry"/>
                </mxCell>
                <mxCell id="t0" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f1f5f9;strokeColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;start: prompt(text) or continue_()&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;from the app&lt;/div&gt;" vertex="1">
                    <mxGeometry height="91" width="520" x="440" y="-62" as="geometry"/>
                </mxCell>
                <mxCell id="t1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="first run of&lt;br&gt;this session?" vertex="1">
                    <mxGeometry height="150" width="360" x="520" y="89" as="geometry"/>
                </mxCell>
                <mxCell id="t1y" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;get ready, once&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;read the project context file (first found of&lt;br&gt;&lt;b&gt;AGENTS.md, CLAUDE.md,&lt;/b&gt; …), only if no system_prompt was given&lt;br&gt;&lt;b&gt;plugins&lt;/b&gt;: setup(api, config), then &lt;b&gt;session_start&lt;/b&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="139" width="420" x="1060" y="94.5" as="geometry"/>
                </mxCell>
                <mxCell id="t2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="a plugin returned&lt;br&gt;&quot;handled&quot;?" vertex="1">
                    <mxGeometry height="150" width="360" x="520" y="531" as="geometry"/>
                </mxCell>
                <mxCell id="t2y" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f1f5f9;strokeColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;stop · the model is not called&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the plugin's work is already done:&lt;br&gt;it ran inside the input hook, before it returned &quot;handled&quot;&lt;br&gt;e.g. /stats: the hook prints the token count, then returns {&quot;handled&quot;: True}&lt;br&gt;nothing is added to history; prompt() returns []&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="420" x="1074" y="521" as="geometry"/>
                </mxCell>
                <mxCell id="t3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;before_agent_start hook&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;each plugin may add messages (they go in with the prompt)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="117" width="520" x="440" y="741" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:20px&quot;&gt;run the agent · click to open its flowchart&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;page 2a: the whole loop, with the session's hooks&lt;br&gt;before each model call: &lt;span style=&quot;color: rgb(0, 0, 204);&quot;&gt;compact&lt;/span&gt; if too big&lt;br&gt;before each tool: plugins (block or change args),&lt;br&gt;then approve() for bash / write / edit&lt;br&gt;every &lt;span style=&quot;color: rgb(219, 39, 119);&quot;&gt;event&lt;/span&gt;: saved (&lt;span style=&quot;color: rgb(219, 39, 119);&quot;&gt;message_end&lt;/span&gt;) and sent on&lt;/div&gt;" link="data:page/id,loop" tooltip="open page 2a · Agent loop" id="t4">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fde68a;strokeColor=#b45309;strokeWidth=3;fontColor=#7c2d12;" vertex="1">
                        <mxGeometry height="186" width="520" x="440" y="958" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="t5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="the last answer&lt;br&gt;is an error?" vertex="1">
                    <mxGeometry height="150" width="360" x="520" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="t6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="too long for the model?&lt;br&gt;(auto_compact on &amp;amp; first time exceed)" vertex="1">
                    <mxGeometry height="150" width="360" x="520" y="1414" as="geometry"/>
                </mxCell>
                <mxCell id="t6y" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;&lt;span style=&quot;color:#0369a1&quot;&gt;compact&lt;/span&gt; once&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;summarize the old messages, keep the recent ones&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;: &lt;span style=&quot;color:#0369a1&quot;&gt;compaction_start&lt;/span&gt;, &lt;span style=&quot;color:#0369a1&quot;&gt;compaction_end&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="137" width="420" x="1060" y="1420" as="geometry"/>
                </mxCell>
                <mxCell id="t7" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="a short failure?&lt;br&gt;(429, 5xx, network; retries left)" vertex="1">
                    <mxGeometry height="150" width="360" x="520" y="1624" as="geometry"/>
                </mxCell>
                <mxCell id="t7y" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;wait, then try again&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;wait 2s, then 4s, then 8s (3 retries)&lt;br&gt;Stop pressed (now, or any time in this run) → stop at once&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;: &lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_start&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="137" width="420" x="1060" y="1630" as="geometry"/>
                </mxCell>
                <mxCell id="t8" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#1d4ed8;" value="&lt;b style=&quot;font-size:20px&quot;&gt;go on: continue_()&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the agent asks the model again on the same history&lt;br&gt;the error answer stays saved, but the model never sees it&lt;/div&gt;" vertex="1">
                    <mxGeometry height="137" width="520" x="440" y="1834" as="geometry"/>
                </mxCell>
                <mxCell id="t9" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f1f5f9;strokeColor=#475569;" value="&lt;b style=&quot;font-size:20px&quot;&gt;the run ends&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;if it retried: &lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_end&lt;/span&gt; (success or not)&lt;br&gt;returns the new messages of this run&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;: &lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_end&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="137" width="520" x="440" y="2103" as="geometry"/>
                </mxCell>
                <mxCell id="t10" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fef2f2;strokeColor=#dc2626;" value="&lt;b style=&quot;font-size:20px&quot;&gt;stop with the error&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;a fatal, budget or policy error, a second overflow,&lt;br&gt;no retries left, or &lt;span style=&quot;color:#0369a1&quot;&gt;compaction&lt;/span&gt; failed&lt;br&gt;the error answer is the last message&lt;br&gt;if it retried before: &lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_end&lt;/span&gt; (no success)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="480" x="-126" y="1619" as="geometry"/>
                </mxCell>
                <mxCell id="t11" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fef2f2;strokeColor=#dc2626;" value="&lt;b style=&quot;font-size:20px&quot;&gt;stop · Stop was pressed&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;auto_retry_end&lt;/span&gt; (no success)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="86" width="300" x="1663" y="1655.5" as="geometry"/>
                </mxCell>
