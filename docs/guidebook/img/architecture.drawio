                <mxCell id="a172" edge="1" parent="1" source="a145" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1d4ed8;strokeWidth=2;" target="a146" value="yes">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a173" edge="1" parent="1" source="a145" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1d4ed8;strokeWidth=2;" target="a147" value="no">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a174" edge="1" parent="1" source="a147" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1d4ed8;strokeWidth=2;" target="a148" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a175" edge="1" parent="1" source="a148" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#2563eb;dashed=1;strokeWidth=3;exitX=0;exitY=0.5;entryX=0;entryY=0.3;" target="a130" value="yes: next turn (inner loop)">
                    <mxGeometry relative="1" x="-0.3547" y="15" as="geometry">
                        <mxPoint y="1" as="offset"/>
                        <Array as="points">
                            <mxPoint x="384.5" y="2268"/>
                            <mxPoint x="384.5" y="293"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a176" edge="1" parent="1" source="a148" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1d4ed8;strokeWidth=2;" target="a149" value="no">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a177" edge="1" parent="1" source="a149" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#7c3aed;dashed=1;strokeWidth=3;exitX=1;exitY=0.5;entryX=1;entryY=0.3;" target="a130" value="yes: add it, next turn (outer loop)">
                    <mxGeometry relative="1" x="-0.264" as="geometry">
                        <Array as="points">
                            <mxPoint x="1960" y="2546"/>
                            <mxPoint x="1960" y="293"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a178" edge="1" parent="1" source="a149" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1d4ed8;strokeWidth=2;" target="a150" value="no">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a179" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#cbd5e1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;three loops&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b style='color:#7c3aed'&gt;outer loop&lt;/b&gt;: the model is done, but a follow_up waits → ask again&lt;br&gt;&lt;b style='color:#2563eb'&gt;inner loop&lt;/b&gt;: the model called tools, or you typed a steer → ask again&lt;br&gt;&lt;b style='color:#475569'&gt;tool loop&lt;/b&gt;: one pass for each tool call in the answer&lt;br&gt;&lt;b style=&quot;color:#1d4ed8&quot;&gt;1 2 3 4&lt;/b&gt;: the steps of page 2 (build, add the answer, tools, anything more?)&lt;br&gt;&lt;b style=&quot;color:#dc2626&quot;&gt;red&lt;/b&gt;: a way out of the run (error or abort)&lt;br&gt;grey text = the &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt; sent out at that step&lt;/div&gt;" vertex="1">
                    <mxGeometry height="230" width="620" x="1000" y="2710" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:20px&quot;&gt;← back to the agent block&lt;/b&gt;" link="data:page/id,agent" id="back2">
                    <mxCell parent="1" style="rounded=1;html=1;fillColor=#f1f5f9;strokeColor=#64748b;" vertex="1">
                        <mxGeometry height="50" width="260" x="20" y="20" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="ab1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#fef2f2;strokeColor=#dc2626;dashed=1;" value="&lt;b style=&quot;font-size:20px&quot;&gt;you press Stop: abort()&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;sets the cancel flag, at any time, from outside the loop (UI, Ctrl-C, server)&lt;br&gt;• model streaming: the stream is closed at once&lt;br&gt;• waiting for approval: the answer is &quot;User denied: aborted&quot; (Part 4: the session's approve)&lt;br&gt;• tools running: the tool sees ctx.cancel and stops; checked before each tool&lt;/div&gt;" vertex="1">
                    <mxGeometry height="230" width="460" x="-300" y="560" as="geometry"/>
                </mxCell>
                <mxCell id="ab2" edge="1" parent="1" source="ab1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeWidth=2;dashed=1;strokeColor=#dc2626;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="a131" value="abort() any time: close the stream">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ab3" edge="1" parent="1" source="ab1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeWidth=2;dashed=1;strokeColor=#dc2626;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" target="a145" value="checked before each tool, and after the tools">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="-232.4" y="790"/>
                            <mxPoint x="-232.4" y="1440.3"/>
                            <mxPoint x="540" y="1440.3"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ex_c0" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;examples: one path through this chart each&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;each one starts from the run on page 2 (&quot;write fizz.py and run it&quot;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;the boxes named in &quot;quotes&quot; are the boxes of this chart&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="124" width="700" x="2070" y="650" as="geometry"/>
                </mxCell>
                <mxCell id="ex_c1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;1 · you press Stop while the model writes&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&quot;ask the AI block&quot;: the stream is closed at once&lt;br&gt;the partial answer &quot;I will write the&quot; is kept, stop_reason = aborted&lt;br&gt;&quot;add the answer to history&quot; → &quot;stop_reason is error or aborted?&quot; yes&lt;br&gt;→ &quot;stop the run&quot;   &lt;span style=&quot;color:#94a3b8&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;: &lt;span style=&quot;color:#db2777&quot;&gt;turn_end&lt;/span&gt;, &lt;span style=&quot;color:#db2777&quot;&gt;agent_end&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;the steer and follow_up queues are kept for next time&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="193" width="700" x="2070" y="804" as="geometry"/>
                </mxCell>
                <mxCell id="ex_c2" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;2 · you press Stop while bash runs&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;bash sees ctx.cancel (the cancel flag every tool gets): the command is killed&lt;br&gt;result: &quot;…[Command interrupted by the user after 3s]&quot;&lt;br&gt;next tool call? &quot;abort() before this tool?&quot; yes → skip the rest&lt;br&gt;&quot;was abort() set?&quot; yes&lt;br&gt;→ &quot;add an aborted answer · stop&quot;   &lt;span style=&quot;color:#94a3b8&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;: &lt;span style=&quot;color:#db2777&quot;&gt;turn_end&lt;/span&gt;, &lt;span style=&quot;color:#db2777&quot;&gt;agent_end&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;skipped calls get &quot;No result provided&quot; when the history is sent again&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="216" width="700" x="2070" y="1027" as="geometry"/>
                </mxCell>
                <mxCell id="ex_c3" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;3 · you type a steer: &quot;call it fizz2.py&quot;&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;it waits in the steer queue; the loop reads it at a safe point:&lt;br&gt;• before the next model call, or • after the tool batch&lt;br&gt;&quot;this turn had tool calls, or a steer is waiting?&quot; yes&lt;br&gt;→ &quot;&lt;span style=&quot;color:#db2777&quot;&gt;turn_start&lt;/span&gt; · add the waiting messages&quot;: user &quot;call it fizz2.py&quot;&lt;br&gt;→ the next model call sees it   &lt;span style=&quot;color:#94a3b8&quot;&gt;a steer never cuts a tool batch&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="193" width="700" x="2070" y="1273" as="geometry"/>
                </mxCell>
                <mxCell id="ex_c4" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;4 · you send a follow_up: &quot;&gt;&gt; then add tests&quot;&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;it waits until the loop would stop&lt;br&gt;turn 3 ends with text, no tool calls, no steer&lt;br&gt;&quot;a follow_up is waiting?&quot; yes → add it, next turn (outer loop)&lt;br&gt;→ the model now writes the tests, in the same run&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="700" x="2070" y="1496" as="geometry"/>
                </mxCell>
                <mxCell id="ex_c5" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;5 · the answer is cut off (max tokens)&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the model writes a long write call, the vendor stops: stop_reason = length&lt;br&gt;&quot;a tool call not handled yet?&quot; yes → &quot;answer cut off?&quot; yes&lt;br&gt;→ result: &quot;Tool call was truncated (max tokens); not executed&quot;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;no tool_execution &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;: the cut args are never run&lt;/span&gt;&lt;br&gt;&quot;this turn had tool calls?&quot; yes → ask again; the model sees the error&lt;/div&gt;" vertex="1">
                    <mxGeometry height="216" width="700" x="2070" y="1696" as="geometry"/>
                </mxCell>
                <mxCell id="ex_c6" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;6 · you deny a tool&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&quot;before_tool_call denies it?&quot; yes: you answered N to &quot;Allow bash?&quot;&lt;br&gt;→ result: &quot;User denied: denied&quot;, is_error = true&lt;br&gt;→ after_tool_call → add the result → ask again&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;the model reads the denial and picks another plan&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="700" x="2070" y="1942" as="geometry"/>
                </mxCell>
                <mxCell id="ex_c7" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;fontColor=#334155;fontFamily=Menlo;" value="&lt;b style=&quot;font-size:20px&quot;&gt;7 · the vendor fails (network down)&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;AI block: one error &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt;, stop_reason = error&lt;br&gt;&quot;stop_reason is error or aborted?&quot; yes → &quot;stop the run&quot;&lt;br&gt;&lt;span style=&quot;color:#94a3b8&quot;&gt;retry is not here: the session (Part 4) may wait and call continue_()&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="147" width="700" x="2070" y="2142" as="geometry"/>
                </mxCell>
                <mxCell id="b1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#1d4ed8;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 20px;&quot;&gt;build the request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;hook&lt;/b&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;: prepare_next_turn(history) → what the model may see&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;(the agent never &lt;/span&gt;&lt;span style=&quot;color: rgb(3, 105, 161); background-color: transparent;&quot;&gt;compacts&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;; in Part 4 the session fills this hook:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(3, 105, 161); background-color: transparent;&quot;&gt;compact&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt; if too big, then the plugins' context hook)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;read the steer queue again: a steer typed now joins this call&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;tools changed? add a short note for the model&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;(it goes into history, with message events; none on the first run)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;system prompt and API key for this call&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;LoopConfig only: transform_context / convert_to_llm (default: no change)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="140" width="840" x="470" y="419" as="geometry"/>
                </mxCell>
                <mxCell id="b1e" edge="1" parent="1" source="a130" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeWidth=2;strokeColor=#1d4ed8;" target="b1" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=20;fontStyle=1;" value="1" vertex="1">
                    <mxGeometry height="44" width="44" x="945" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=20;fontStyle=1;" value="2" vertex="1">
                    <mxGeometry height="44" width="44" x="945" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=20;fontStyle=1;" value="3" vertex="1">
                    <mxGeometry height="44" width="44" x="1850" y="1063" as="geometry"/>
                </mxCell>
                <mxCell id="s4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1d4ed8;fontColor=#ffffff;fontSize=20;fontStyle=1;strokeColor=#db2777;" value="4" vertex="1">
                    <mxGeometry height="44" width="44" x="915" y="2246" as="geometry"/>
                </mxCell>
                <mxCell id="hooknote" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fffbeb;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#334155;" value="&lt;b style=&quot;font-size:20px&quot;&gt;the agent's hooks&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;a &lt;b&gt;hook&lt;/b&gt; = an empty slot: a function the app may give the agent,&lt;br&gt;called at a fixed moment. None given → skipped.&lt;br&gt;&lt;br&gt;&lt;b&gt;before_tool_call(call, ctx)&lt;/b&gt; → None = run it, a text = deny (the reason)&lt;br&gt;&lt;b&gt;after_tool_call(call, result, ctx)&lt;/b&gt; → a new result, or None = keep it&lt;br&gt;(it runs after a deny too)&lt;br&gt;&lt;br&gt;also &lt;b&gt;prepare_next_turn(history)&lt;/b&gt; → the view for the model (Agent default: build_view = the last &lt;span style=&quot;color:#0369a1&quot;&gt;compaction&lt;/span&gt; summary&lt;br&gt;+ the messages after it; custom entries dropped)&lt;br&gt;(step &quot;build the request&quot;; Part 4 &lt;span style=&quot;color:#0369a1&quot;&gt;compacts&lt;/span&gt; here)&lt;br&gt;&lt;br&gt;only these hooks here, plain functions, no plugins.&lt;br&gt;&lt;b&gt;Part 4&lt;/b&gt;: the session fills these 2 slots with its own functions;&lt;br&gt;inside, they run every plugin's tool_call / tool_result,&lt;br&gt;then approve() asks you (bash / write / edit).&lt;br&gt;&lt;br&gt;&lt;b&gt;example&lt;/b&gt; (no session):&lt;br&gt;&lt;span style=&quot;font-family:Menlo&quot;&gt;Agent(..., before_tool_call=lambda call, ctx:&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;no shell&quot; if call.name == &quot;bash&quot; else None)&lt;/span&gt;&lt;br&gt;→ bash gets &quot;User denied: no shell&quot;; other tools run&lt;/div&gt;" vertex="1">
                    <mxGeometry height="553" width="620" x="2070" y="2340" as="geometry"/>
                </mxCell>
                <mxCell id="hn_a140" edge="1" parent="1" source="hooknote" style="endArrow=none;dashed=1;strokeColor=#94a3b8;strokeWidth=2;" target="a140" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="hn_a143" edge="1" parent="1" source="hooknote" style="endArrow=none;dashed=1;strokeColor=#94a3b8;strokeWidth=2;" target="a143" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a141_a143" edge="1" parent="1" source="a141" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1d4ed8;strokeWidth=2;" target="a143" value="">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1720" y="1765"/>
                            <mxPoint x="1300" y="1765"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
