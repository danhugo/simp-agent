                <mxCell id="t6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="too long for the model?&lt;br&gt;(first time, auto_compact on)" vertex="1">
                    <mxGeometry x="520" y="1244" width="360" height="150" as="geometry" />
                </mxCell>
                <mxCell id="t6y" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;compact once&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;summarize the old messages, keep the recent ones&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;events: compaction_start, compaction_end&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry x="1060" y="1250" width="420" height="137" as="geometry" />
                </mxCell>
                <mxCell id="t7" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="a short failure?&lt;br&gt;(429, 5xx, network; retries left)" vertex="1">
                    <mxGeometry x="520" y="1454" width="360" height="150" as="geometry" />
                </mxCell>
                <mxCell id="t7y" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;strokeWidth=2;fontColor=#0f172a;fillColor=#f0fdfa;strokeColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;wait, then try again&lt;/b&gt;&lt;div style=&quot;font-size:15px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;wait 2s, then 4s, then 8s (3 retries)&lt;br&gt;abort() during the wait → stop&lt;br&gt;&lt;span style=&quot;color:#64748b&quot;&gt;events: auto_retry_start&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry x="1060" y="1460" width="420" height="137" as="geometry" />
