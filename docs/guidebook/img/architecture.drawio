0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:19px&quot;&gt;calls: prompt(), steer(), follow_up(), abort(), compact(), continue_()&lt;/b&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1320" y="1410" width="380" height="110" as="geometry"/></mxCell><mxCell id="r5e17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="a8" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5e18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="b8" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="key" value="&lt;b style=&quot;font-size:22px&quot;&gt;how to read&lt;/b&gt;&lt;div style=&quot;font-size:18px;line-height:1.4;margin-top:4px;padding-left:10px&quot;&gt;&lt;b&gt;green&lt;/b&gt; arrows: plugged in once, when the Run is built (server.py:181-189)&lt;br&gt;&lt;b&gt;pink&lt;/b&gt;: &lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt; going out to the browser&lt;br&gt;&lt;b&gt;grey&lt;/b&gt; (last row): not a socket, the Run just calls the session's methods&lt;br&gt;the session itself does the AI work (page 4); the Run only adapts it to the web&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=6;fillColor=#fffbeb;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1780" y="110" width="640" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram>
