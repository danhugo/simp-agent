                <mxCell id="ae7" edge="1" parent="1" source="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;fontStyle=2;fontColor=#64748b;strokeColor=#1d4ed8;strokeWidth=2;" target="f8" value="">
