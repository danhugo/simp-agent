                <mxCell id="a118" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#fdf2f8;strokeWidth=2;fontColor=#0f172a;strokeColor=#db2777;" value="&lt;b style=&quot;font-size:24px&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;events&lt;/span&gt;, live (to subscribers)&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;span style=&quot;color:#db2777&quot;&gt;agent_start&lt;/span&gt; / &lt;span style=&quot;color:#db2777&quot;&gt;agent_end&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#db2777&quot;&gt;turn_start&lt;/span&gt; / &lt;span style=&quot;color:#db2777&quot;&gt;turn_end&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#db2777&quot;&gt;message_start&lt;/span&gt; / &lt;span style=&quot;color:#db2777&quot;&gt;message_end&lt;/span&gt;: one message added&lt;br&gt;&lt;span style=&quot;color:#db2777&quot;&gt;message_update&lt;/span&gt;: one AI &lt;span style=&quot;color:#db2777&quot;&gt;event&lt;/span&gt;, passed on&lt;br&gt;&lt;span style=&quot;color:#db2777&quot;&gt;tool_execution_start&lt;/span&gt; / update / end&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="270" y="1375" as="geometry"/>
                </mxCell>
                <mxCell id="a119" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;" value="&lt;b style=&quot;font-size:24px&quot;&gt;the result&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;the new messages of this run&lt;br&gt;(user, assistant, tool results)&lt;br&gt;the history now holds them too&lt;br&gt;a failure in the run ends as an error message&lt;br&gt;raises only: prompt() while running, continue_() &quot;Cannot continue&quot;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="265" width="520" x="810" y="1375" as="geometry"/>
                </mxCell>
                <mxCell id="a120" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" value="&lt;b style=&quot;font-size:22px&quot;&gt;plugs in&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;&lt;b&gt;env&lt;/b&gt;: where tools run (local, or other)&lt;br&gt;&lt;b&gt;get_api_key&lt;/b&gt;: the key, before every AI call&lt;br&gt;&lt;b&gt;stream_fn&lt;/b&gt;: the AI block, or a fake one for tests&lt;br&gt;&lt;b&gt;hooks&lt;/b&gt;: prepare_next_turn (what the model sees),&lt;br&gt;before / after a tool call&lt;/div&gt;" vertex="1">
                    <mxGeometry height="230" width="420" x="1520" y="715" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b style=&quot;font-size:22px&quot;&gt;used by: the session (Part 4) · click to open&lt;/b&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:6px;padding-left:14px&quot;&gt;it builds the Agent and fills its hooks&lt;br&gt;apps (CLI, server) talk to the session, not to the Agent&lt;/div&gt;" link="data:page/id,session" tooltip="open page 4 · Session block" id="a121">
                    <mxCell parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;strokeWidth=2;fontColor=#475569;" vertex="1">
