                </mxCell>
                <mxCell id="f9" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0f172a;" value="another chunk&lt;br&gt;from the vendor?" vertex="1">
                    <mxGeometry height="150" width="360" x="520" y="1230" as="geometry" />
